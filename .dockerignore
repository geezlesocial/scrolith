# Ignore everything by default so Docker only receives files that the
# deployment Dockerfiles actually copy.
*
.*

# Keep this file visible to the builder.
!.dockerignore

# Frontend deploy inputs.
!deploy/
!deploy/docker/
!deploy/docker/frontend.Dockerfile
!deploy/nginx/
!deploy/nginx/frontend.conf
!geezle/
geezle/*
!geezle/package.json
!geezle/package-lock.json
!geezle/index.html
!geezle/vite.config.ts
!geezle/tsconfig.json
!geezle/postcss.config.cjs
!geezle/tailwind.config.js
!geezle/scripts/
!geezle/scripts/getBackendTarget.js
!geezle/public/
!geezle/public/**
!geezle/src/
!geezle/src/**

# Backend deploy inputs.
!deploy/docker/backend.Dockerfile
!geezle-backend/
geezle-backend/*
!geezle-backend/package.json
!geezle-backend/package-lock.json
!geezle-backend/tsconfig.json
!geezle-backend/prisma/
!geezle-backend/prisma/**
!geezle-backend/scripts/
!geezle-backend/scripts/**
!geezle-backend/src/
!geezle-backend/src/**
