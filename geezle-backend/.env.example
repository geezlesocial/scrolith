# Geezle Backend environment example
# Copy this file to .env and replace the placeholders with real values

# Required
DATABASE_URL=postgresql://DB_USER:DB_PASS@localhost:5432/DB_NAME
JWT_SECRET=your_jwt_secret_here
PORT=5000
FRONTEND_URL=http://localhost:3000

# Optional
EMAIL_HOST=smtp.example.com
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key
SCROLITHA_PROVIDER=ollama
SCROLITHA_OLLAMA_HOST=http://127.0.0.1:11434
SCROLITHA_OLLAMA_MODEL=llama3.1
SCROLITHA_MAX_TOKENS=1024
SCROLITHA_TEMPERATURE=0.7
SCROLITHA_TOP_P=0.9
SCROLITHA_TIMEOUT_MS=25000
SCROLITHA_ENABLE_STREAMING=false
SCROLITHA_GEMINI_FALLBACK=false
UPLOAD_DRIVER=local # local | azure_blob | s3 | backblaze (takes precedence over STORAGE_DRIVER)
STORAGE_DRIVER=local # legacy fallback
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
AZURE_BLOB_BASE_URL=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_B64=
FCM_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Notes:
# - Do NOT commit your real .env to version control. Use .env.example in the repo instead.
# - Prisma reads DATABASE_URL from the environment or an .env file in the project root.
