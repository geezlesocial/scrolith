# Geezle Backend environment example
# Copy this file to .env and replace the placeholders with real values

# Required
DATABASE_URL=postgresql://DB_USER:DB_PASS@localhost:5432/DB_NAME
JWT_SECRET=your_jwt_secret_here
PORT=5000
FRONTEND_URL=http://localhost:3000

# Optional
EMAIL_HOST=smtp.example.com
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key
STORAGE_DRIVER=local # or s3 or backblaze

# Notes:
# - Do NOT commit your real .env to version control. Use .env.example in the repo instead.
# - Prisma reads DATABASE_URL from the environment or an .env file in the project root.
