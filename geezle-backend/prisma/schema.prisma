  payload          Json
  version          Int
  source           String   @default("admin")
  reason           String?
  metadata         Json?
  createdByStaffId String?
  createdAt        DateTime @default(now())

  beforeChanges ConfigChange[] @relation("ConfigChangeBeforeSnapshot")
  afterChanges  ConfigChange[] @relation("ConfigChangeAfterSnapshot")
  beforeRuns    RollbackRun[]  @relation("RollbackBeforeSnapshot")
  afterRuns     RollbackRun[]  @relation("RollbackAfterSnapshot")

  @@unique([scope, key, version])
  @@index([scope, key, createdAt])
  @@index([createdByStaffId, createdAt])
}

model ConfigChange {
  id               String   @id @default(cuid())
  scope            String
  key              String   @default("default")
  action           String
  beforeSnapshotId String?
  afterSnapshotId  String?
