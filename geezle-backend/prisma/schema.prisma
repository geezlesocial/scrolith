  @@index([userId])
}

model CommunityMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String   @db.Text
  aiFlagged Boolean  @default(false)
  aiReason  String?
  createdAt DateTime @default(now())

