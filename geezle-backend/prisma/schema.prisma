// Tracks deduplicated events that contribute toward Gcoin earnings (idempotent)
model GcoinEarningEvent {
  id        String   @id @default(cuid())
  postId    String
  actorId   String? // the user who caused the event (viewer/liker/sharer)
  eventType String // view|like|share|repost
  eventKey  String // idempotency key (e.g. sessionHash|actorId|day)
  value     Float    @default(0) // coins awarded when threshold crossed
  credited  Boolean  @default(false)
  createdAt DateTime @default(now())

  post  CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([eventKey])
  @@index([postId])
  @@index([actorId])
  @@index([eventType])
}

// Ads models scoped to Community
model CommunityAd {
  id                   String    @id @default(cuid())
  creatorId            String
  title                String
  body                 String    @db.Text
  objective            String    @default("traffic") // traffic, messages
  destinationType      String    @default("url") // url, messages
  destinationUrl       String?
  ctaText              String?
  placement            String
  targeting            Json?
  mediaFileIds         String[]  @default([])
  status               AdStatus  @default(DRAFT)
  currency             String    @default("USD")
  budget               Float     @default(0)
  remainingBudget      Float     @default(0)
  cpm                  Float     @default(0) // cost per 1000 impressions
  cpc                  Float     @default(0)
  impressionsBought    Int       @default(0)
  impressionsLeft      Int       @default(0)
  clicks               Int       @default(0)
  impressions          Int       @default(0)
  likes                Int       @default(0)
  messagesStarted      Int       @default(0)
  startAt              DateTime?
  endAt                DateTime?
  durationDays         Int?
  adminReviewNotes     String?
  paymentTransactionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  creator  User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metrics  AdMetricsDaily[]
  payments AdPayment[]

  @@index([creatorId])
  @@index([status])
  @@index([placement])
}

// Aggregated daily metrics for ads (scale-friendly)
model AdMetricsDaily {
  id          String   @id @default(cuid())
  adId        String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  createdAt   DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([adId])
  @@index([date])
}

// Payment record for ad prepayments (links to existing Transaction if available)
model AdPayment {
  id            String   @id @default(cuid())
  adId          String
  transactionId String?
  amount        Float
  currency      String   @default("USD")
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([transactionId])
}

