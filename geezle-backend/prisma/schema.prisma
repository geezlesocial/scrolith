  submission KYCSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([submissionId])
  @@index([policyVersion])
  @@index([acceptedAt])
}

/// Append-only KYC audit trail. Metadata is allowlist-only (no identity payloads).
model KYCAuditEvent {
  id              String   @id @default(cuid())
  submissionId    String?
  documentId      String?
  actorType       String
  actorId         String?
  actorUserId     String?
  action          String
  reasonCode      String?
  priorState      String?
  resultingState  String?
  correlationId   String?
  serviceIdentity String?
  metadata        Json?
  createdAt       DateTime @default(now())

  submission KYCSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actorUser  User?          @relation("KYCAuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([documentId])
  @@index([action])
  @@index([actorType])
  @@index([createdAt])
  @@index([correlationId])
}

