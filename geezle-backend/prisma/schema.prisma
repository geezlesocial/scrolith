model CommunityBusinessPageFollower {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page CommunityBusinessPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
}

model CommunityBusinessPageAdmin {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  role      String   @default("admin") // admin, editor
  createdAt DateTime @default(now())

  page CommunityBusinessPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
}

// Tracks deduplicated events that contribute toward Gcoin earnings (idempotent)
model GcoinEarningEvent {
  id        String   @id @default(cuid())
  postId    String
  actorId   String? // the user who caused the event (viewer/liker/sharer)
  eventType String // view|like|share|repost
  eventKey  String // idempotency key (e.g. sessionHash|actorId|day)
  value     Float    @default(0) // coins awarded when threshold crossed
  credited  Boolean  @default(false)
  createdAt DateTime @default(now())

  post  CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([eventKey])
  @@index([postId])
  @@index([actorId])
  @@index([eventType])
}

// Ads models scoped to Community
model CommunityAd {
  id                   String    @id @default(cuid())
  creatorId            String
  title                String
  body                 String    @db.Text
  objective            String    @default("traffic") // traffic, messages
  destinationType      String    @default("url") // url, messages
  destinationUrl       String?
  ctaText              String?
  placement            String
  targeting            Json?
  mediaFileIds         String[]  @default([])
  status               AdStatus  @default(DRAFT)
  currency             String    @default("USD")
  budget               Float     @default(0)
  remainingBudget      Float     @default(0)
  cpm                  Float     @default(0) // cost per 1000 impressions
  cpc                  Float     @default(0)
  impressionsBought    Int       @default(0)
  impressionsLeft      Int       @default(0)
  clicks               Int       @default(0)
  impressions          Int       @default(0)
  likes                Int       @default(0)
  messagesStarted      Int       @default(0)
  startAt              DateTime?
  endAt                DateTime?
  durationDays         Int?
  adminReviewNotes     String?
  paymentTransactionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  creator  User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metrics  AdMetricsDaily[]
  payments AdPayment[]

  @@index([creatorId])
  @@index([status])
  @@index([placement])
}

// Aggregated daily metrics for ads (scale-friendly)
model AdMetricsDaily {
  id          String   @id @default(cuid())
  adId        String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  createdAt   DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([adId])
  @@index([date])
}

// Payment record for ad prepayments (links to existing Transaction if available)
model AdPayment {
  id            String   @id @default(cuid())
  adId          String
  transactionId String?
  amount        Float
  currency      String   @default("USD")
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([transactionId])
}

// Social: followers/following
model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
  @@index([followerId, createdAt])
  @@index([followeeId, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksFor", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Notifications for in-app alerts (+ Phase 32.0 foundation fields, additive)
model Notification {
  id             String    @id @default(cuid())
  userId         String
  actorId        String?
  type           String
  title          String?
  body           String?
  meta           Json?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  /// Phase 32.0 — taxonomy category
  category       String?
  /// Phase 32.0 — critical|high|normal|low|silent
  priority       String    @default("normal")
  deepLink       String?
  eventId        String?
  idempotencyKey String?
  entityType     String?
  entityId       String?
  schemaVersion  String    @default("32.0")
  archivedAt     DateTime?
  deletedAt      DateTime?
  readAt         DateTime?
  /// Phase 32.1 — pin important notifications to top of inbox
  pinnedAt       DateTime?

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt, id])
  @@index([userId, isRead, createdAt, id])
  @@index([userId, category, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, pinnedAt, createdAt])
  @@index([userId, priority, createdAt])
  @@index([eventId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([isRead])
}

// Phase 32.0 — canonical emit event log
model NotificationEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  category       String
  actorId        String?
  actorType      String?
  recipientIds   String[] @default([])
  entityType     String?
  entityId       String?
  title          String?
  body           String?
  deepLink       String?
  priority       String   @default("normal")
  metadata       Json?
  idempotencyKey String?
  schemaVersion  String   @default("32.0")
  source         String?
  correlationId  String?
  status         String   @default("emitted")
  createdAt      DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([category, createdAt])
  @@index([idempotencyKey])
  @@index([createdAt])
}

// Phase 32.0 — multi-channel delivery attempts
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  eventId        String?
  userId         String
  channel        String
  status         String    @default("pending")
  attemptCount   Int       @default(0)
  errorCode      String?
  errorMessage   String?
  latencyMs      Int?
  providerMeta   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deliveredAt    DateTime?

  @@index([userId, createdAt])
  @@index([notificationId])
  @@index([eventId])
  @@index([status, createdAt])
  @@index([channel, status])
}

// Phase 32.0 — per-user category preference overrides (extends UserSettings)
// Phase 32.2 — deliveryMode, minPriority, sound/vibration/preview, version
model NotificationPreference {
  id                String    @id @default(cuid())
  userId            String
  category          String
  inAppEnabled      Boolean   @default(true)
  pushEnabled       Boolean   @default(true)
  emailEnabled      Boolean   @default(true)
  smsEnabled        Boolean   @default(false)
  digestEnabled     Boolean   @default(false)
  quietHoursEnabled Boolean   @default(false)
  focusMode         Boolean   @default(false)
  mutedUntil        DateTime?
  deliveryMode      String    @default("immediate")
  minPriority       String    @default("normal")
  soundEnabled      Boolean   @default(true)
  vibrationEnabled  Boolean   @default(true)
  previewEnabled    Boolean   @default(true)
  version           Int       @default(1)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// Phase 32.2 — per-event preference overrides
model NotificationEventPreference {
  id            String   @id @default(cuid())
  userId        String
  eventType     String
  category      String?
  inAppEnabled  Boolean?
  pushEnabled   Boolean?
  emailEnabled  Boolean?
  deliveryMode  String?
  minPriority   String?
  muted         Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, eventType])
  @@index([userId])
}

// Phase 32.2 — global user notification settings (one row per user)
model NotificationGlobalPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  pauseOptional          Boolean  @default(false)
  allowMandatorySecurity Boolean  @default(true)
  allowEmergencySystem   Boolean  @default(true)
  showPreviews           Boolean  @default(true)
  playSounds             Boolean  @default(true)
  enableVibration        Boolean  @default(true)
  syncReadState          Boolean  @default(true)
  groupSimilar           Boolean  @default(true)
  badgeEnabled           Boolean  @default(true)
  marketingEnabled       Boolean  @default(false)
  productUpdatesEnabled  Boolean  @default(true)
  timezone               String?
  version                Int      @default(1)
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Phase 32.2 — temporary focus mode sessions
model NotificationFocusSession {
  id                     String    @id @default(cuid())
  userId                 String
  startsAt               DateTime  @default(now())
  endsAt                 DateTime?
  indefinite             Boolean   @default(false)
  silencePush            Boolean   @default(true)
  silenceEmail           Boolean   @default(false)
  allowCritical          Boolean   @default(true)
  allowSecurity          Boolean   @default(true)
  allowedCategories      String[]  @default([])
  allowedUserIds         String[]  @default([])
  allowedConversationIds String[]  @default([])
  active                 Boolean   @default(true)
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, active])
  @@index([endsAt])
}

// Phase 32.2 — digest schedule (one row per user)
model NotificationDigestSchedule {
  id              String    @id @default(cuid())
  userId          String    @unique
  mode            String    @default("off")
  enabled         Boolean   @default(false)
  timezone        String    @default("UTC")
  morningHour     Int       @default(8)
  morningMinute   Int       @default(0)
  eveningHour     Int       @default(19)
  eveningMinute   Int       @default(0)
  dailyHour       Int       @default(9)
  dailyMinute     Int       @default(0)
  weeklyDay       Int       @default(1)
  weeklyHour      Int       @default(9)
  weeklyMinute    Int       @default(0)
  emailEnabled    Boolean   @default(true)
  inAppEnabled    Boolean   @default(true)
  pushReadyAlert  Boolean   @default(false)
  includeRead     Boolean   @default(false)
  lastRunKey      String?
  lastRunAt       DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, mode])
}

// Phase 32.2 — generated digests
model NotificationDigest {
  id                  String    @id @default(cuid())
  userId              String
  scheduleId          String?
  mode                String
  periodStart         DateTime
  periodEnd           DateTime
  timezone            String    @default("UTC")
  idempotencyKey      String    @unique
  status              String    @default("pending")
  itemCount           Int       @default(0)
  unreadCount         Int       @default(0)
  criticalCount       Int       @default(0)
  highCount           Int       @default(0)
  summaryJson         Json?
  emailStatus         String?
  inAppNotificationId String?
  errorMessage        String?
  readAt              DateTime?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model NotificationDigestItem {
  id             String   @id @default(cuid())
  digestId       String
  notificationId String?
  eventId        String?
  category       String?
  priority       String?
  title          String?
  body           String?
  deepLink       String?
  groupKey       String?
  sortOrder      Int      @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([digestId])
  @@index([notificationId])
}

// Phase 32.2 — quiet hours / focus deferred suppressions
model NotificationSuppression {
  id             String    @id @default(cuid())
  userId         String
  notificationId String?
  eventId        String?
  channel        String
  reason         String
  action         String
  nextEligibleAt DateTime?
  releasedAt     DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([nextEligibleAt])
}

// Phase 32.0 — audit trail
model NotificationAudit {
  id             String   @id @default(cuid())
  action         String
  notificationId String?
  eventId        String?
  userId         String?
  actorId        String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([notificationId])
  @@index([eventId])
  @@index([createdAt])
}

// Phase 32.0 — analytics counters (dashboard later)
model NotificationAnalyticsCounter {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  category  String?
  metric    String
  value     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, category, metric])
  @@index([date])
}

// Phase 32.4 — ops templates (versioned)
model NotificationOpsTemplate {
  id                String    @id @default(cuid())
  key               String
  name              String
  channel           String
  locale            String    @default("en")
  subject           String?
  title             String?
  body              String    @default("")
  htmlBody          String?
  variables         Json?
  version           Int       @default(1)
  status            String    @default("draft")
  publishedAt       DateTime?
  previousVersionId String?
  metadata          Json?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([key, channel, locale, version])
  @@index([status, channel])
  @@index([key])
}

// Phase 32.4 — announcement / emergency campaigns
model NotificationCampaign {
  id              String    @id @default(cuid())
  name            String
  type            String    @default("platform_announcement")
  status          String    @default("draft")
  priority        String    @default("normal")
  title           String
  body            String
