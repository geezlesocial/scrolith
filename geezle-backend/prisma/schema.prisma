  maxDurationSeconds           Int      @default(90)
  aiLabelRequired              Boolean  @default(false)
  autoModeration               Boolean  @default(false)
  monetizationEnabled          Boolean  @default(true)
  defaultVisibility            String   @default("public")
  impressionThresholdSeconds   Int      @default(2)
  headlinePreviewCharacters    Int      @default(72)
  descriptionPreviewCharacters Int      @default(120)
  allowedFilterPresets         String[] @default(["none", "vibrant", "cinematic", "bw", "sepia", "warm"])
  updatedById                  String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model LiveSession {
  id              String    @id @default(cuid())
  hostUserId      String
  title           String?
  description     String?   @db.Text
  visibility      String    @default("public")
  status          String    @default("SCHEDULED")
  roomName        String?
  streamUrl       String?
  hlsUrl          String?
  recordingFileId String?
  viewerCount     Int       @default(0)
  peakViewerCount Int       @default(0)
  likesCount      Int       @default(0)
  lovesCount      Int       @default(0)
  metadata        Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participants     LiveParticipant[]
  invites          LiveInvite[]
  gifts            LiveGift[]
  reactionCounters LiveReactionCounter[]
  reports          LiveReport[]

  @@index([hostUserId, createdAt])
  @@index([status, createdAt])
  @@index([visibility, status, createdAt])
}

model LiveParticipant {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String
  role        String    @default("VIEWER")
  micState    Boolean   @default(true)
  cameraState Boolean   @default(true)
  status      String    @default("INVITED")
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status, createdAt])
  @@index([userId, status, createdAt])
}

model LiveInvite {
  id          String    @id @default(cuid())
  sessionId   String
  inviterId   String
  inviteeId   String
  status      String    @default("PENDING")
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, inviteeId])
  @@index([inviteeId, status, createdAt])
  @@index([sessionId, status, createdAt])
}

model LiveGift {
  id          String   @id @default(cuid())
  sessionId   String
  fromUserId  String
  toUserId    String
  amountGcoin Int
  message     String?
  createdAt   DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

model LiveReactionCounter {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String?
  reactionType String
  count        Int      @default(1)
  createdAt    DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, reactionType, createdAt])
  @@index([userId, createdAt])
}

model LiveReport {
  id           String    @id @default(cuid())
  sessionId    String
  reportedById String
  reason       String
  status       String    @default("PENDING")
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
  @@index([reportedById, createdAt])
  @@index([status, createdAt])
}

model LiveConfig {
  id                          String   @id @default("default")
  enabled                     Boolean  @default(true)
  enableConference            Boolean  @default(true)
  maxParticipants             Int      @default(20)
  maxGuests                   Int      @default(6)
  enableGifts                 Boolean  @default(true)
  minGiftGcoin                Int      @default(1)
  maxGiftGcoin                Int      @default(50000)
  enableRecording             Boolean  @default(true)
  defaultVisibility           String   @default("public")
  rateLimitReactionsPerMinute Int      @default(80)
  rateLimitChatPerMinute      Int      @default(40)
  updatedById                 String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model CommunityStory {
  id             String   @id @default(cuid())
  authorId       String
  type           String   @default("text") // text, image, video
  content        String?
  mediaFileId    String?
  visibility     String   @default("public") // public, friends, network, private, custom
  commentsCount  Int      @default(0)
  repostsCount   Int      @default(0)
  dashesCount    Int      @default(0)
  sendsCount     Int      @default(0)
  textBackground String?  @map("text_background")
  textColor      String?  @map("text_color")
  textFont       String?  @map("text_font")
  textAlign      String?  @map("text_align")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views   CommunityStoryView[]
  likes   CommunityStoryLike[]
  replies CommunityStoryReply[]

  @@index([authorId])
  @@index([expiresAt])
  @@index([visibility])
}

model CommunityStoryLike {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model CommunityStoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String?
  createdAt DateTime @default(now())

  story  CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User?          @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
}

model CommunityStoryReply {
  id        String   @id @default(cuid())
  storyId   String
  authorId  String
  parentId  String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story   CommunityStory        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author  User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  CommunityStoryReply?  @relation("CommunityStoryReplyChain", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityStoryReply[] @relation("CommunityStoryReplyChain")

  @@index([storyId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
}

model CommunityPoll {
  id            String    @id @default(cuid())
  creatorUserId String?
  key           String?   @unique
  title         String
  prompt        String    @db.Text
  kind          String    @default("poll")
  status        String    @default("active")
  sourceScope   String    @default("member_home")
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creator User?                 @relation("CommunityPollCreatedBy", fields: [creatorUserId], references: [id], onDelete: SetNull)
  options CommunityPollOption[]
  votes   CommunityPollVote[]

  @@index([creatorUserId, createdAt])
  @@index([status, createdAt])
  @@index([sourceScope, status, createdAt])
}

model CommunityPollOption {
  id          String   @id @default(cuid())
  pollId      String
  label       String
  description String?
  accent      String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poll  CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes CommunityPollVote[]

  @@unique([pollId, position])
  @@index([pollId])
}

model CommunityPollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll   CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@index([userId, createdAt])
}

model CommunityBusinessPage {
  id               String    @id @default(cuid())
  ownerId          String
  name             String
  handle           String    @unique
  slug             String    @unique
  tagline          String?
  category         String?
  description      String?
  website          String?
  email            String?
  phone            String?
  industry         String?
  orgSize          String?
  orgType          String?
  location         String?
  formattedAddress String?
  country          String?
  countryCode      String?
  state            String?
  city             String?
  region           String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  placeId          String?
  locationSource   String?
  logoFileId       String?
  coverFileId      String?
  status           String    @default("active")
  statusReason     String?
  statusUpdatedBy  String?
  statusUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner             User                            @relation("BusinessPageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  followers         CommunityBusinessPageFollower[]
