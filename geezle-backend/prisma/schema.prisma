  channels        String[]  @default([])
  targeting       Json?
  templateId      String?
  scheduleType    String    @default("immediate")
  scheduledAt     DateTime?
  recurrence      Json?
  reason          String?
  requiresConfirm Boolean   @default(false)
  confirmedAt     DateTime?
  confirmedBy     String?
  sentAt          DateTime?
  cancelledAt     DateTime?
  stats           Json?
  metadata        Json?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([type, createdAt])
}

model NotificationCampaignDelivery {
  id             String    @id @default(cuid())
  campaignId     String
  userId         String?
  channel        String
  status         String    @default("pending")
  notificationId String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([campaignId, status])
  @@index([userId])
}

// Phase 32.4 — delivery retry queue
model NotificationRetryJob {
  id             String    @id @default(cuid())
  notificationId String?
  deliveryId     String?
  userId         String?
  channel        String
  status         String    @default("pending")
  attemptCount   Int       @default(0)
