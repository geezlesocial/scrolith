// Community Post model for feed-style posts (separate from ForumThread)
model CommunityPost {
  id                             String    @id @default(cuid())
  authorId                       String
  title                          String?
  content                        String    @db.Text
  sourceLanguage                 String?
  sourceLanguageConfidence       Float?
  /// Phase 26 — detection status: detected | low_confidence | mixed | no_linguistic_content | unsupported | detection_failed | not_processed
  languageDetectionStatus        String?
  isMixedLanguage                Boolean   @default(false)
  detectedLanguageCodes          String[]  @default([])
  languageManuallySet            Boolean   @default(false)
  languageDetectedAt             DateTime?
  contentHash                    String?
  translationVersion             String?
  attachments                    String[]  @default([])
  attachmentCaptions             Json?
  offerTags                      Json?
  tags                           String[]  @default([])
  mentions                       String[]  @default([])
  topic                          String?
  location                       String?
  visibility                     String    @default("public") // public, friends, network, private, custom
  graphicWarning                 Boolean   @default(false) // content warning flag (UI-only)
  commentPolicy                  String    @default("everyone") // everyone, followers, following, mutuals, none
  repostsEnabled                 Boolean   @default(true)
  originalPostId                 String?
  businessPageId                 String?
  clubId                         String?
  viewsCount                     Int       @default(0)
  likesCount                     Int       @default(0)
  sharesCount                    Int       @default(0)
  repostsCount                   Int       @default(0)
  status                         String    @default("active") // active, draft, deleted
  isPinned                       Boolean   @default(false)
  isHighlighted                  Boolean   @default(false)
  isAIEnhanced                   Boolean   @default(false)
  aiInsightEnabled               Boolean   @default(false)
  aiInsightGenerated             Boolean   @default(false)
  aiInsightText                  String?   @db.Text
  aiScore                        Float?
  videoFingerprint               String?
  videoIntegrityStatus           String    @default("clear")
  videoIntegrityMatchMethod      String?
  videoIntegrityMatchScore       Float?
  videoMonetizationBlocked       Boolean   @default(false)
  videoIntegrityMatchedContentId String?
  videoIntegrityMatchedOwnerId   String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  author       User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  businessPage CommunityBusinessPage? @relation(fields: [businessPageId], references: [id], onDelete: SetNull)
  club         CommunityClub?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  originalPost CommunityPost?         @relation("CommunityPostReposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      CommunityPost[]        @relation("CommunityPostReposts")

  // Earning events and relations
  earningEvents      GcoinEarningEvent[]
  comments           CommunityPostComment[]
  reactions          CommunityPostReaction[]
  hiddenBy           CommunityPostHidden[]
  feedback           CommunityPostFeedback[]
  reports            CommunityPostReport[]
  prediction         PostPrediction?
  savedInCollections PostCollectionItem[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceLanguage])
  @@index([languageDetectionStatus])
  @@index([isMixedLanguage])
  @@index([contentHash])
  @@index([businessPageId])
  @@index([clubId])
  @@index([visibility])
  @@index([topic])
  @@index([location])
  @@index([status, isPinned, createdAt])
  @@index([status, visibility, isPinned, createdAt])
  @@index([businessPageId, status, isPinned, createdAt])
  @@index([clubId, status, isPinned, createdAt])
  @@index([authorId, status, createdAt])
  @@index([visibility, status, createdAt])
  @@index([videoIntegrityStatus])
  @@index([videoMonetizationBlocked])
}

