// Direct messaging (1:1 and group)
model Conversation {
  id                  String                    @id @default(cuid())
  type                ConversationType          @default(DIRECT)
  lastMessageText     String?
  lastMessageAt       DateTime?
  lastMessageSenderId String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  /// Phase 22.2 — group display metadata
  title               String?
  description         String?                   @db.Text
  avatarFileId        String?
  visibility          ConversationVisibility    @default(PRIVATE)
  source              String?
  sourceId            String?
  /// Phase 29.1 — Enterprise Messaging Groups identity + policy
  category            String?
  language            String?
  country             String?
  region              String?
  timezone            String?
  bannerFileId        String?
  emoji               String?
  accentColor         String?
  joinPolicy          ConversationJoinPolicy    @default(INVITE_ONLY)
  messagingMode       ConversationMessagingMode @default(EVERYONE)
  slowModeSeconds     Int                       @default(0)
  maxMembers          Int?
  memberCount         Int                       @default(0)
  settingsVersion     Int                       @default(1)
  lockedAt            DateTime?
  lockedReason        String?
  lockedById          String?
  lockExpiresAt       DateTime?
  archivedAt          DateTime?
  lastActivityAt      DateTime?
  /// Sparse permission overrides: { "MEMBER": { "canInvite": true }, ... }
  permissionOverrides Json?
  orgVerified         Boolean                   @default(false)

  participants       ConversationParticipant[]
  messages           DirectMessage[]
  messageRecords     DirectMessageRecord[]
  voiceCalls         VoiceCall[]
  voiceNotes         VoiceNote[]
  invites            ConversationInvite[]
  groupSettings      ConversationSettings?
  joinRequests       ConversationJoinRequest[]
  memberRestrictions ConversationMemberRestriction[]
  moderationActions  GroupModerationAction[]
  pinnedMessages     ConversationPinnedMessage[]

  @@index([updatedAt])
  @@index([updatedAt, id])
  @@index([lastMessageAt])
  @@index([type, visibility])
  @@index([source, sourceId])
  @@index([type, joinPolicy])
  @@index([type, messagingMode])
  @@index([type, lastActivityAt])
  @@index([archivedAt])
}

model ConversationParticipant {
  id                  String                        @id @default(cuid())
  conversationId      String
  userId              String
  joinedAt            DateTime                      @default(now())
  lastReadAt          DateTime?
  /// Phase 22.3 — delivery watermark (receiver acknowledged receive)
  lastDeliveredAt     DateTime?
  label               String                        @default("other")
  isStarred           Boolean                       @default(false)
  isMuted             Boolean                       @default(false)
  isArchived          Boolean                       @default(false)
  deletedAt           DateTime?
  /// Phase 22.2
  role                ConversationMemberRole        @default(MEMBER)
  notifications       ConversationNotificationLevel @default(ALL)
  /// Phase 29.1 — profile overlay: guest | readOnly | bot | coOwner (null = default for role)
  profileKey          String?
  /// Phase 29.1 — last successful send (slow mode)
  lastMessageAt       DateTime?
  /// Phase 29.1 — sparse per-member permission overrides
  permissionOverrides Json?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, deletedAt, conversationId])
  @@index([conversationId, role])
  @@index([conversationId, profileKey])
}

/// Phase 22.2 — group invitations
/// Phase 29.1 — maxUses, oneTime, requireApproval, previewDisabled, label, useCount
model ConversationInvite {
  id              String                   @id @default(cuid())
  conversationId  String
  code            String                   @unique
  inviteeUserId   String?
  invitedById     String
  role            ConversationMemberRole   @default(MEMBER)
  status          ConversationInviteStatus @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  acceptedAt      DateTime?
  /// Phase 29.1
  maxUses         Int?
  useCount        Int                      @default(0)
  oneTime         Boolean                  @default(false)
  requireApproval Boolean                  @default(false)
  previewDisabled Boolean                  @default(false)
  label           String?
  qrTokenHash     String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([inviteeUserId, status])
  @@index([code])
  @@index([qrTokenHash])
