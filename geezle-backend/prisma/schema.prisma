generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                String    @id @default(cuid())
  email                             String    @unique
  username                          String?   @unique
  passwordHash                      String?
  name                              String?
  role                              Role      @default(USER)
  avatar                            String?
  profilePhotoFileId                String?
  phone                             String?
  country                           String?
  timezone                          String?
  kycStatus                         KYCStatus @default(PENDING)
  isVerified                        Boolean   @default(false)
  isActive                          Boolean   @default(true)
  isOnline                          Boolean   @default(false)
  lastLoginAt                       DateTime?
  lastSeenAt                        DateTime?
  /// Phase 22.3 — presence privacy (EVERYONE | CONTACTS | NOBODY); maps to onlineStatusVisibility
  presenceVisibility                String    @default("EVERYONE")
  /// Phase 22.3B — messaging privacy controls (additive; defaults preserve current behavior)
  lastSeenVisibility                String    @default("EVERYONE")
  readReceiptsEnabled               Boolean   @default(true)
  typingIndicatorsEnabled           Boolean   @default(true)
  recordingIndicatorsEnabled        Boolean   @default(true)
  directMessageAudience             String    @default("EVERYONE")
  groupInviteAudience               String    @default("EVERYONE")
  notificationMessagePreviewEnabled Boolean   @default(true)
  messagingPrivacyUpdatedAt         DateTime?
  freelancerPlanId                  String?
  freelancerPlanName                String?
  freelancerPlanInterval            String?
  freelancerPlanPrice               Float?
  freelancerPlanCurrency            String?
  freelancerPlanActive              Boolean   @default(false)
  freelancerPlanPurchasedAt         DateTime?
  freelancerPlanExpiresAt           DateTime?
  employerPlanId                    String?
  employerPlanName                  String?
  employerPlanInterval              String?
  employerPlanPrice                 Float?
  employerPlanCurrency              String?
  employerPlanActive                Boolean   @default(false)
  employerPlanPurchasedAt           DateTime?
  employerPlanExpiresAt             DateTime?
  stripeAccountId                   String?
  refreshToken                      String?
  followOnboardingRequired          Boolean   @default(false)
  followOnboardingCompletedAt       DateTime?
  /// Phase 26 — languages the user understands (not nationality/locale)
  understoodLanguages               String[]  @default([])
  preferredTranslationLanguage      String?
  languageSuggestionsEnabled        Boolean   @default(true)
  autoTranslateEnabled              Boolean   @default(false)
  languagePreferencesUpdatedAt      DateTime?
  languagePreferencesConfirmed      Boolean   @default(false)
  /// Phase 28 — preferred display currency (ISO 4217). Null = use platform default.
  preferredCurrency                 String?   @map("preferred_currency")
  currencyPreferenceUpdatedAt       DateTime? @map("currency_preference_updated_at")
  /// Admin / platform Google Authenticator (TOTP) 2FA
  twoFactorSecret                   String?
  twoFactorEnabled                  Boolean   @default(false)
  twoFactorBackupCodes              String[]  @default([])
  twoFactorEnrolledAt               DateTime?
  twoFactorWaivedUntil              DateTime?
  twoFactorWaivedById               String?
  twoFactorWaivedReason             String?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  // Relationships
  profile              Profile?
  settings             UserSettings?
  gigs                 Gig[]
  jobs                 Job[]
  wallet               Wallet?
  transactions         Transaction[]
  walletFundingIntents WalletFundingIntent[]

  // Order relationships
  clientOrders     Order[] @relation("OrderClient")
  freelancerOrders Order[] @relation("OrderFreelancer")

  // Contracts (ATM Tracker)
  clientContracts     Contract[] @relation("ClientContracts")
  freelancerContracts Contract[] @relation("FreelancerContracts")

  // Reviews
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")

  // Proposals
  proposals Proposal[]

  // Favorites
  favorites                   Favorite[]
  postCollections             PostCollection[]
  cart                        Cart?
  marketplaceListings         MarketplaceListing[]  @relation("MarketplaceListingSeller")
  marketplaceInquiriesBuying  MarketplaceInquiry[]  @relation("MarketplaceInquiryBuyer")
  marketplaceInquiriesSelling MarketplaceInquiry[]  @relation("MarketplaceInquirySeller")
  marketplaceReportsFiled     MarketplaceReport[]   @relation("MarketplaceReportReporter")
  marketplaceReportsResolved  MarketplaceReport[]   @relation("MarketplaceReportResolver")
  marketplaceOrdersPlaced     MarketplaceOrder[]    @relation("MarketplaceOrderBuyer")
  marketplaceOrdersSold       MarketplaceOrder[]    @relation("MarketplaceOrderSeller")
  marketplaceAuditLogs        MarketplaceAuditLog[] @relation("MarketplaceAuditActor")

  // Gcoin
  gcoinWallet       GcoinWallet?
  gcoinTransactions GcoinTransaction[]       @relation("GcoinUserTransactions")
  gcoinConversions  GcoinConversionRequest[] @relation("GcoinUserConversions")

  // Withdrawal requests
  withdrawalRequests WithdrawalRequest[]

  // CMS Config updates
  cmsConfigUpdates CMSConfig[]

  // Admin-created Gcoin configs
  gcoinConfigsUpdated      GcoinConfig[]
  preloaderConfigsUpdated  PreloaderConfig[]
  translationValuesUpdated TranslationValue[] @relation("TranslationValueUpdatedBy")
  textOverridesUpdated     TextOverride[]     @relation("TextOverrideUpdatedBy")
  languageConfigsUpdated   LanguageConfig[]   @relation("LanguageConfigUpdatedBy")

  // Market intelligence relationships
  ltvPredictions LtvPrediction[]

  // Community relationships
  forumThreads          ForumThread[]
  forumComments         ForumComment[]
  forumLikes            ForumLike[]
  communityClubs        CommunityClub[]     @relation("ClubOwner")
  clubMemberships       ClubMembership[]
  clubJoinRequests      ClubJoinRequest[]   @relation("ClubJoinRequestUser")
  clubModerationActions ClubJoinRequest[]   @relation("ClubJoinRequestModerator")
  clubInvitesReceived   ClubInvite[]        @relation("ClubInviteRecipient")
  clubInvitesSent       ClubInvite[]        @relation("ClubInviteSender")
  communityEvents       CommunityEvent[]    @relation("EventHost")
  eventRegistrations    EventRegistration[]
  communityChannels     CommunityChannel[]  @relation("ChannelOwner")
  channelMemberships    ChannelMembership[]
  communityMessages     CommunityMessage[]
  kycSubmissions        KYCSubmission[]
  kycDocuments          KYCDocument[]
  kycConsents           KYCConsent[]
  kycAuditEvents        KYCAuditEvent[]     @relation("KYCAuditActorUser")

  // Direct messaging
  conversations         ConversationParticipant[]
  sentMessages          DirectMessage[]
  initiatedVoiceCalls   VoiceCall[]               @relation("VoiceCallInitiator")
  voiceCallParticipants VoiceCallParticipant[]    @relation("VoiceCallParticipantUser")
  voiceNotes            VoiceNote[]               @relation("VoiceNoteSender")
  messageReactions      MessageReaction[]
  messageRecordActions  DirectMessageRecord[]     @relation("MessageRecordActor")
  messageRecordTargets  DirectMessageRecord[]     @relation("MessageRecordTarget")
  reactions             Reaction[]

  // Social relations (followers & following)
  following UserFollow[] @relation("UserFollows")
  followers UserFollow[] @relation("UserFollowers")

  // Notifications
  notifications       Notification[]       @relation("NotificationUser")
  notificationsActed  Notification[]       @relation("NotificationActor")
  deviceTokens        DeviceToken[]
  passwordResetTokens PasswordResetToken[]
  authAuditLogs       AuthAuditLog[]

  // Social / OAuth providers
  authProviderAccounts AuthProviderAccount[]

  // Community posts, earnings, and ads relations
  communityPosts                     CommunityPost[]
  gcoinEarningEvents                 GcoinEarningEvent[]
  communityAds                       CommunityAd[]
  communityPostComments              CommunityPostComment[]
  communityPostReactions             CommunityPostReaction[]
  communityPostCommentLikes          CommunityPostCommentLike[]
  communityPostHides                 CommunityPostHidden[]
  communityPostFeedback              CommunityPostFeedback[]
  communityPostReports               CommunityPostReport[]
  communityNotificationSubscriptions CommunityNotificationSubscription[]
  communityStories                   CommunityStory[]
  communityStoryLikes                CommunityStoryLike[]
  communityStoryViews                CommunityStoryView[]
  communityStoryReplies              CommunityStoryReply[]
  communityPollsCreated              CommunityPoll[]                     @relation("CommunityPollCreatedBy")
  communityPollVotes                 CommunityPollVote[]
  communityBusinessPages             CommunityBusinessPage[]             @relation("BusinessPageOwner")
  businessPageFollows                CommunityBusinessPageFollower[]
  businessPageAdminships             CommunityBusinessPageAdmin[]
  scrollSeriesCreated                ScrollSeries[]                      @relation("ScrollSeriesCreator")
  scrollSeriesItemsAdded             ScrollSeriesItem[]                  @relation("ScrollSeriesItemAddedBy")
  scrollHides                        ScrollHidden[]
  scrollFeedback                     ScrollFeedback[]

  // Profile views
  profileViewsReceived ProfileView[] @relation("ProfileViewViewed")
  profileViewsGiven    ProfileView[] @relation("ProfileViewViewer")

  // Community user blocks
  blocksInitiated UserBlock[] @relation("UserBlocksBy")
  blocksReceived  UserBlock[] @relation("UserBlocksFor")

  // Staff/RBAC
  staffProfile StaffUser?

  // Monetization
  monetizationApplications         MonetizationApplication[] @relation("UserMonetizationApplications")
  monetizationReviewedApplications MonetizationApplication[] @relation("MonetizationReviewedBy")
  monetizationProfile              MonetizationProfile?      @relation("UserMonetizationProfile")
  accountViolations                AccountViolation[]        @relation("UserAccountViolations")
  payoutProviderAccounts           PayoutProviderAccount[]

  // Insights & growth intelligence (additive layer)
  professionalScore         ProfessionalScore?
  insightEvents             InsightEvent[]
  insightAchievements       UserAchievement[]
  insightStreak             UserStreak?
  careerDailyActions        CareerDailyAction[]
  friendStreakPairsLow      FriendStreak[]          @relation("FriendStreakUserLow")
  friendStreakPairsHigh     FriendStreak[]          @relation("FriendStreakUserHigh")
  friendStreakInvitesSent   FriendStreak[]          @relation("FriendStreakInitiatedBy")
  creatorChallengesCreated  CreatorChallenge[]      @relation("CreatorChallengeCreatedBy")
  creatorChallengesUpdated  CreatorChallenge[]      @relation("CreatorChallengeUpdatedBy")
  creatorChallengeEntries   CreatorChallengeEntry[]
  creatorChallengeVotes     CreatorChallengeVote[]
  opportunityMatches        OpportunityMatch[]
  postPredictionsAuthored   PostPrediction[]        @relation("PostPredictionAuthor")
  aiCopilotLogs             AICopilotLog[]
  skillGapReports           SkillGapReport[]
  feedModePreference        FeedModePreference?
  topicFollows              TopicFollow[]
  feedIntentSignals         FeedIntentSignal[]
  savedPipelineItems        SavedPipelineItem[]
  questCatalogsCreated      QuestCatalog[]          @relation("QuestCatalogCreatedBy")
  questCatalogsUpdated      QuestCatalog[]          @relation("QuestCatalogUpdatedBy")
  userQuests                UserQuest[]             @relation("UserQuestUser")
  questCompletionLogs       QuestCompletionLog[]    @relation("QuestCompletionUser")
  portfolioProofsOwned      PortfolioProof[]        @relation("PortfolioProofOwner")
  portfolioProofsVerified   PortfolioProof[]        @relation("PortfolioProofVerifiedBy")
  proofAttestationsAsClient ProofAttestation[]      @relation("ProofAttestationClient")
  proofAttestationsAsActor  ProofAttestation[]      @relation("ProofAttestationActor")
  proofAuditActions         ProofAuditLog[]         @relation("ProofAuditActor")
  projectPodsOwned          ProjectPod[]            @relation("ProjectPodOwner")
  podMemberships            PodMember[]             @relation("PodMemberUser")
  podInvitationsSent        PodMember[]             @relation("PodMemberInvitedBy")
  podMilestonesCreated      PodMilestone[]          @relation("PodMilestoneCreatedBy")
  podMilestonesAssigned     PodMilestone[]          @relation("PodMilestoneAssignedTo")
  podActivities             PodActivity[]           @relation("PodActivityActor")
  questionsAuthored         Question[]              @relation("QuestionAuthor")
  answersAuthored           Answer[]                @relation("AnswerAuthor")
  votes                     Vote[]                  @relation("VoteUser")
  bountiesSponsored         Bounty[]                @relation("BountySponsor")
  channelSubscriptions      ChannelSubscription[]   @relation("ChannelSubscriptionUser")
  officeHoursHosted         EventOfficeHour[]       @relation("OfficeHourHost")
  analyticsDaily            UserAnalyticsDaily[]    @relation("UserAnalyticsDailyUser")
  moderationCasesAuthored   ModerationCase[]        @relation("ModerationCaseAuthor")
  moderationCasesCreated    ModerationCase[]        @relation("ModerationCaseCreatedBy")
  moderationActions         ModerationAction[]      @relation("ModerationActionActor")

  // Developer platform (https://scrolith.com/developer)
  developerProfile   DeveloperUser?
  developerOwnedApps DeveloperApp[] @relation("DeveloperOwnedApps")

  // Resume / CV builder and reviewer
  resumeDocuments ResumeDocument[] @relation("ResumeDocuments")
  resumeAnalyses  ResumeAnalysis[] @relation("ResumeAnalyses")
}

model Profile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  title                   String?
  bio                     String?
  location                String?
  formattedAddress        String?
  country                 String?
  countryCode             String?
  state                   String?
  city                    String?
  region                  String?
  postalCode              String?
  latitude                Float?
  longitude               Float?
  placeId                 String?
  locationSource          String?
  gender                  String?
  dateOfBirth             DateTime?
  showBirthMonthDayPublic Boolean   @default(true)
  skills                  String[]
  hourlyRate              Float?
  experience              String?
  education               String?
  languages               String[]
  introVideoUrl           String?
  coverPhotoUrl           String?
  portfolio               Json?
  experienceItems         Json?
  educationItems          Json?
  certifications          Json?
  portfolioUrl            String?
  githubUrl               String?
  linkedinUrl             String?
  websiteUrl              String?
  rating                  Float     @default(0)
  completedJobs           Int       @default(0)
  responseRate            Float     @default(0)
  responseTime            Int? // in hours
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ResumeDocument {
  id             String   @id @default(cuid())
  userId         String
  freelancerId   String?
  title          String
  targetRole     String?
  targetIndustry String?
  template       String   @default("professional")
  includePhoto   Boolean  @default(false)
  photoUrl       String?
  status         String   @default("draft")
  sourceSnapshot Json?
  editableData   Json?
  aiOutput       Json?
  pdfUrl         String?
  pdfStorageKey  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User            @relation("ResumeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  versions ResumeVersion[]

  @@index([userId])
  @@index([freelancerId])
  @@index([status])
}

model ResumeVersion {
  id            String   @id @default(cuid())
  resumeId      String
  versionNumber Int
  changeReason  String?
  prompt        String?
  editableData  Json?
  aiOutput      Json?
  pdfUrl        String?
  pdfStorageKey String?
  createdAt     DateTime @default(now())

  resume ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
}

model ResumeAnalysis {
  id                  String   @id @default(cuid())
  clientId            String
  jobTitle            String?
  jobDescription      String
  requiredSkills      Json?
  preferredSkills     Json?
  seniorityLevel      String?
  sourceType          String
  sourceFileUrl       String?
  sourceFileName      String?
  sourceMimeType      String?
  profileUrl          String?
  extractedText       String?
  normalizedCandidate Json?
  analysisResult      Json?
  overallScore        Int?
  roleFitScore        Int?
  status              String   @default("pending")
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client User @relation("ResumeAnalyses", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model ProfileView {
  id           String   @id @default(cuid())
  viewerId     String?
  viewedUserId String
  createdAt    DateTime @default(now())

  viewer     User? @relation("ProfileViewViewer", fields: [viewerId], references: [id])
  viewedUser User  @relation("ProfileViewViewed", fields: [viewedUserId], references: [id])

  @@index([viewedUserId, createdAt])
  @@index([viewerId, createdAt])
}

model UserSettings {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  emailNotifications           Boolean  @default(true)
  inAppNotifications           Boolean  @default(true)
  messageRequestsNotifications Boolean  @default(true)
  allowInMail                  Boolean  @default(true)
  notifyMentions               Boolean  @default(true)
  notifyFollowedPosts          Boolean  @default(true)
  notifyFollowedYou            Boolean  @default(true)
  notifyCommentsOnPosts        Boolean  @default(true)
  notifyReactionsOnPosts       Boolean  @default(true)
  notifyReposts                Boolean  @default(true)
  notifyJobApplications        Boolean  @default(true)
  notifyApplicationUpdates     Boolean  @default(true)
  marketingEmails              Boolean  @default(true)
  // Earning rules
  viewsUnit                    Int      @default(10000)
  likesUnit                    Int      @default(100)
  repostsUnit                  Int      @default(50)
  sharesUnit                   Int      @default(200)
  coinPerViewsUnit             Float    @default(1)
  coinPerLikesUnit             Float    @default(1)
  coinPerRepostsUnit           Float    @default(1)
  coinPerSharesUnit            Float    @default(1)
  // Admin fee on earnings (e.g., 0.1 = 10%)
  adminFeePercent              Float    @default(0.1)
  // Transfer fee settings
  transferFeeType              String   @default("percentage")
  transferFeeValue             Float    @default(0)
  twoFactorEnabled             Boolean  @default(false)
  loginAlerts                  Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Gig {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String
  price         Float
  deliveryTime  Int // in days
  revisions     Int         @default(1)
  categoryId    String?
  subcategory   String?
  pricingMode   String      @default("packages")
  packages      Json?
  extras        Json?
  faqs          Json?
  requirements  Json?
  images        String[]    @default([])
  videos        String[]    @default([])
  documents     String[]    @default([])
  tags          String[]    @default([])
  image         String?
  meta          Json?
  userId        String
  rating        Float?      @default(0)
  reviewCount   Int         @default(0)
  isActive      Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  isTopSelected Boolean     @default(false)
  isRecommended Boolean     @default(false)
  status        GigStatus   @default(PENDING)
  adminStatus   AdminStatus @default(PENDING)
  adminReason   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relationships
  category        Category?        @relation(fields: [categoryId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]
  portfolioProofs PortfolioProof[]
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String
  budget          String?
  type            JobType          @default(FIXED_PRICE)
  postedTime      DateTime         @default(now())
  tags            String[]
  proposalsCount  Int              @default(0)
  status          JobStatus        @default(DRAFT)
  isActive        Boolean          @default(true)
  isVisible       Boolean          @default(true)
  categoryId      String?
  subcategory     String?
  experienceLevel ExperienceLevel?
  visibility      Visibility       @default(PUBLIC)
  duration        String?
  attachments     String[]
  isFeatured      Boolean          @default(false)
  isTopSelected   Boolean          @default(false)
  isRecommended   Boolean          @default(false)
  adminStatus     AdminStatus      @default(PENDING)
  adminReason     String?
  clientId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id])
  client    User       @relation(fields: [clientId], references: [id])
  proposals Proposal[]
  cartItems CartItem[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

model Proposal {
  id                   String         @id @default(cuid())
  jobId                String
  freelancerId         String
  coverLetter          String         @db.Text
  proposedAmount       Float
  proposedTimeline     Int
  attachments          String[]       @default([])
  status               ProposalStatus @default(PENDING)
  rejectionReason      String?
  contractId           String?
  clientViewedAt       DateTime?
  clientViewCount      Int            @default(0)
  topApplicantAt       DateTime?
  interviewScheduledAt DateTime?
  interviewMode        String?
  interviewLocation    String?
  interviewNotes       String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer User @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
}

model Contract {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        ContractType @default(HOURLY)

  clientId       String
  freelancerId   String
  clientName     String?
  freelancerName String?

  hourlyRate      Float        @default(0)
  paymentCycle    PaymentCycle @default(WEEKLY)
  contractValue   Float?
  deliveryDays    Int?
  paymentSchedule Json?
  milestones      Json?

  status    ContractStatus @default(ACTIVE)
  startDate DateTime       @default(now())

  jobId            String?
  sourceProposalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     User @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User @relation("FreelancerContracts", fields: [freelancerId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]
  sessions    TrackingSession[]
  projectPods ProjectPod[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model TimeEntry {
  id           String @id @default(cuid())
  contractId   String
  freelancerId String

  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int
  description     String
  status          TimeEntryStatus @default(PENDING)
  earnings        Float           @default(0)
  screenshots     String[]        @default([])
  activityScore   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([freelancerId])
  @@index([status])
  @@index([startTime])
  @@index([createdAt])
}

model TrackingSession {
  id           String        @id @default(cuid())
  contractId   String
  freelancerId String
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  status       SessionStatus @default(ACTIVE)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([freelancerId])
  @@index([status])
  @@index([startedAt])
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  icon        String?
  description String?
  type        CategoryType @default(GIG)
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  parent              Category?            @relation("CategoryChildren", fields: [parentId], references: [id])
  children            Category[]           @relation("CategoryChildren")
  gigs                Gig[]
  jobs                Job[]
  forumThreads        ForumThread[]        @relation("ForumCategory")
  marketplaceListings MarketplaceListing[] @relation("MarketplaceListingCategory")
}

model Order {
  id             String      @id @default(cuid())
  gigId          String?
  clientId       String
  freelancerId   String
  amount         Float
  status         OrderStatus @default(PENDING)
  requirements   String?
  deliveryDate   DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  stripeIntentId String?
  transactionId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relationships
  gig             Gig?                 @relation(fields: [gigId], references: [id])
  client          User                 @relation("OrderClient", fields: [clientId], references: [id])
  freelancer      User                 @relation("OrderFreelancer", fields: [freelancerId], references: [id])
  escrow          Escrow?
  transactions    Transaction[]
  review          Review?
  paymentIntents  OrderPaymentIntent[]
  portfolioProofs PortfolioProof[]
  projectPods     ProjectPod[]
}

model Review {
  id          String       @id @default(cuid())
  rating      Int
  title       String?
  comment     String?      @db.Text
  gigId       String?
  orderId     String?      @unique
  authorId    String
  subjectId   String
  status      ReviewStatus @default(PENDING)
  editedAt    DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  gig     Gig?   @relation(fields: [gigId], references: [id], onDelete: SetNull)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  author  User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@index([authorId])
  @@index([subjectId])
  @@index([status])
}

model KYCSubmission {
  id                   String              @id @default(cuid())
  userId               String
  status               KYCSubmissionStatus @default(PENDING)
  personalInfo         Json
  reviewedAt           DateTime?
  reviewedBy           String?
  rejectionReason      String?
  decisionReasonCode   String?
  consentPolicyVersion String?
  consentAcceptedAt    DateTime?
  resubmissionCount    Int                 @default(0)
  // Retention placeholders — final durations require legal approval (Phase 20.2)
  retentionPolicyKey   String?
  retainUntil          DateTime?
  legalHold            Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   KYCDocument[]
  consents    KYCConsent[]
  auditEvents KYCAuditEvent[]

  @@index([userId])
  @@index([status])
  @@index([retainUntil])
}

model KYCDocument {
  id                        String    @id @default(cuid())
  submissionId              String?
  userId                    String
  type                      String
  fileId                    String
  /// Legacy public media URL. Phase 20.2 private KYC docs store empty string; objectKey is SSOT.
  fileUrl                   String    @default("")
  status                    String    @default("pending")
  rejectionReason           String?
  purpose                   String    @default("kyc")
  storageClass              String    @default("LEGACY")
  objectKey                 String?
  quarantineObjectKey       String?
  quarantineStatus          String    @default("UNKNOWN")
  scanStatus                String?
  scanEngine                String?
  scanDefinitionVersion     String?
  scannedAt                 DateTime?
  normalizedAt              DateTime?
  sha256                    String?
  contentType               String?
  sizeBytes                 BigInt?
  originalFilenameSanitized String?
  metadataStripped          Boolean   @default(false)
  visibility                String    @default("PRIVATE")
  promotedAt                DateTime?
  width                     Int?
  height                    Int?
  // Retention-ready placeholders (legal approval required for durations)
  retainUntil               DateTime?
  deletedAt                 DateTime?
  uploadedAt                DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  submission KYCSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([userId])
  @@index([objectKey])
  @@index([sha256])
  @@index([quarantineStatus])
  @@index([purpose])
}

/// Explicit KYC consent evidence (not marketing consent).
model KYCConsent {
  id            String   @id @default(cuid())
  userId        String
  submissionId  String?
  policyVersion String
  purpose       String   @default("identity_verification_review")
