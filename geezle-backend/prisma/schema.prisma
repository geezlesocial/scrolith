// Community Forum Models
model ForumThread {
  id         String       @id @default(cuid())
  categoryId String?
  userId     String
  title      String
  content    String       @db.Text
  status     ThreadStatus @default(OPEN)
  isPinned   Boolean      @default(false)
  isLocked   Boolean      @default(false)
  views      Int          @default(0)
  upvotes    Int          @default(0)
  tags       String[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relationships
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?      @relation("ForumCategory", fields: [categoryId], references: [id])
  comments ForumComment[]
  likes    ForumLike[]    @relation("ThreadLikes")

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([isPinned])
  @@index([isPinned, createdAt])
  @@index([categoryId, isPinned, createdAt])
  @@index([createdAt])
}

model ForumComment {
  id        String   @id @default(cuid())
  threadId  String
  parentId  String?
  userId    String
  content   String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  thread       ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent       ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ForumComment[] @relation("CommentReplies")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentLikes ForumLike[]    @relation("CommentLikes")

  @@index([threadId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumLike {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  commentId String?
  createdAt DateTime @default(now())

  // Relationships
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread  ForumThread?  @relation("ThreadLikes", fields: [threadId], references: [id], onDelete: Cascade)
  comment ForumComment? @relation("CommentLikes", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, commentId])
  @@index([userId])
}

model CommunityClub {
  id          String            @id @default(cuid())
  name        String
  description String            @db.Text
  coverImage  String?
  visibility  ChannelVisibility @default(PUBLIC)
  ownerId     String
  memberCount Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relationships
  owner       User             @relation("ClubOwner", fields: [ownerId], references: [id])
  memberships ClubMembership[]

  @@index([ownerId])
  @@index([visibility])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  // Relationships
  club CommunityClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model CommunityEvent {
  id            String    @id @default(cuid())
  title         String
  description   String    @db.Text
  startTime     DateTime
  endTime       DateTime
  type          EventType @default(WORKSHOP)
  hostId        String
  location      String?
  maxAttendees  Int?
  image         String?
  attendeeCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

