// Uploaded Files (single source of truth)
model File {
  id                         String                    @id @default(cuid())
  ownerId                    String?                   @map("owner_id")
  ownerRole                  FileOwnerRole             @default(ADMIN)
  filename                   String
  originalName               String                    @map("original_name")
  mimeType                   String                    @map("mime_type")
  size                       BigInt
  url                        String
  storageKey                 String                    @unique @map("storage_key")
  storageProvider            String                    @default("local") @map("storage_provider")
  thumbnailUrl               String?                   @map("thumbnail_url")
  videoPerceptualHash        String?
  videoPerceptualHashVersion Int?
  width                      Int?
  height                     Int?
  duration                   Float?
  visibility                 FileVisibility            @default(PUBLIC)
  // Phase 3A — image processing (nullable, additive; originals always available)
  processingStatus           FileProcessingStatus      @default(PENDING) @map("processing_status")
  processingVersion          Int                       @default(0) @map("processing_version")
  processingErrorCode        String?                   @map("processing_error_code")
  processingStartedAt        DateTime?                 @map("processing_started_at")
  processingCompletedAt      DateTime?                 @map("processing_completed_at")
  variantsManifest           Json?                     @map("variants_manifest")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  usages                     FileUsage[]
  variants                   FileVariant[]
  voiceNotes                 VoiceNote[]
  marketplaceMedia           MarketplaceListingMedia[]

  @@index([ownerId])
  @@index([ownerRole])
  @@index([createdAt])
  @@index([processingStatus])
  @@map("files")
}

/// Phase 3A — durable image (and later video) derivatives. Idempotent per unique key.
model FileVariant {
  id              String            @id @default(cuid())
  fileId          String            @map("file_id")
  kind            String
  label           String            @default("default")
  width           Int?
  height          Int?
  format          String
  mimeType        String            @map("mime_type")
  storageProvider String            @default("google_cloud_storage") @map("storage_provider")
  storageKey      String            @map("storage_key")
  sizeBytes       BigInt            @default(0) @map("size_bytes")
  checksum        String?
  status          FileVariantStatus @default(READY)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind, width, format, label])
  @@unique([storageKey])
  @@index([fileId])
  @@index([status])
  @@map("file_variants")
}

model ManagedUploadObject {
  id          String   @id @default(cuid())
  objectKey   String   @unique @map("object_key")
  contentType String   @map("content_type")
  sizeBytes   BigInt   @default(0) @map("size_bytes")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("managed_upload_objects")
}

// Tracks where uploaded files are used (SSOT usage references)
model FileUsage {
  id        String   @id @default(cuid())
  fileId    String
  usageType String
  usageId   String
  label     String?
  createdAt DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, usageType, usageId])
  @@index([fileId])
  @@index([usageType, usageId])
}

