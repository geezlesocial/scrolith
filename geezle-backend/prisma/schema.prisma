// Community Forum Models
model ForumThread {
  id         String       @id @default(cuid())
  categoryId String?
  userId     String
  title      String
  content    String       @db.Text
  status     ThreadStatus @default(OPEN)
  isPinned   Boolean      @default(false)
  isLocked   Boolean      @default(false)
  views      Int          @default(0)
  upvotes    Int          @default(0)
  tags       String[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relationships
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?      @relation("ForumCategory", fields: [categoryId], references: [id])
  comments ForumComment[]
  likes    ForumLike[]    @relation("ThreadLikes")

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([isPinned])
  @@index([createdAt])
}

model ForumComment {
  id        String   @id @default(cuid())
  threadId  String
  parentId  String?
  userId    String
  content   String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  thread       ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent       ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ForumComment[] @relation("CommentReplies")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentLikes ForumLike[]    @relation("CommentLikes")

  @@index([threadId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumLike {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  commentId String?
  createdAt DateTime @default(now())

  // Relationships
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread  ForumThread?  @relation("ThreadLikes", fields: [threadId], references: [id], onDelete: Cascade)
  comment ForumComment? @relation("CommentLikes", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, commentId])
  @@index([userId])
}

model CommunityClub {
  id          String            @id @default(cuid())
  name        String
  description String            @db.Text
  coverImage  String?
  visibility  ChannelVisibility @default(PUBLIC)
  ownerId     String
  memberCount Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relationships
  owner       User             @relation("ClubOwner", fields: [ownerId], references: [id])
  memberships ClubMembership[]

  @@index([ownerId])
  @@index([visibility])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  // Relationships
  club CommunityClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model CommunityEvent {
  id            String    @id @default(cuid())
  title         String
  description   String    @db.Text
  startTime     DateTime
  endTime       DateTime
  type          EventType @default(WORKSHOP)
  hostId        String
  location      String?
  maxAttendees  Int?
  image         String?
  attendeeCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  host          User                @relation("EventHost", fields: [hostId], references: [id])
  registrations EventRegistration[]

  @@index([hostId])
  @@index([startTime])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())

  // Relationships
  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model CommunityChannel {
  id           String      @id @default(cuid())
  name         String
  description  String?     @db.Text
  type         ChannelType @default(PUBLIC)
  ownerId      String
  isPublic     Boolean     @default(true)
  memberCount  Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastActivity DateTime?

  // Relationships
  owner       User                @relation("ChannelOwner", fields: [ownerId], references: [id])
  memberships ChannelMembership[]
  messages    CommunityMessage[]

  @@index([ownerId])
  @@index([type])
}

model ChannelMembership {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  // Relationships
  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model CommunityMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String   @db.Text
  aiFlagged Boolean  @default(false)
  aiReason  String?
  createdAt DateTime @default(now())

  // Relationships
  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([userId])
  @@index([createdAt])
}

// Community Post model for feed-style posts (separate from ForumThread)
model CommunityPost {
  id           String   @id @default(cuid())
  authorId     String
  title        String?
  content      String   @db.Text
  attachments  String[] @default([])
  viewsCount   Int      @default(0)
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  repostsCount Int      @default(0)
  status       String   @default("active") // active, draft, deleted
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Earning events and relations
  earningEvents GcoinEarningEvent[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

// Tracks deduplicated events that contribute toward Gcoin earnings (idempotent)
model GcoinEarningEvent {
  id        String   @id @default(cuid())
  postId    String
  actorId   String? // the user who caused the event (viewer/liker/sharer)
  eventType String // view|like|share|repost
  eventKey  String // idempotency key (e.g. sessionHash|actorId|day)
  value     Float    @default(0) // coins awarded when threshold crossed
  credited  Boolean  @default(false)
  createdAt DateTime @default(now())

  post  CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([eventKey])
  @@index([postId])
  @@index([actorId])
  @@index([eventType])
}

// Ads models scoped to Community
model CommunityAd {
  id                   String    @id @default(cuid())
  creatorId            String
  title                String
  body                 String    @db.Text
  placement            String
  targeting            Json?
  mediaFileIds         String[]  @default([])
  status               AdStatus  @default(DRAFT)
  currency             String    @default("USD")
  budget               Float     @default(0)
  remainingBudget      Float     @default(0)
  cpm                  Float     @default(0) // cost per 1000 impressions
  impressionsBought    Int       @default(0)
  impressionsLeft      Int       @default(0)
  clicks               Int       @default(0)
  impressions          Int       @default(0)
  startAt              DateTime?
  endAt                DateTime?
  paymentTransactionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  creator  User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metrics  AdMetricsDaily[]
  payments AdPayment[]

  @@index([creatorId])
  @@index([status])
  @@index([placement])
}

// Aggregated daily metrics for ads (scale-friendly)
model AdMetricsDaily {
  id          String   @id @default(cuid())
  adId        String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  createdAt   DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, date])
  @@index([adId])
  @@index([date])
}

// Payment record for ad prepayments (links to existing Transaction if available)
model AdPayment {
  id            String   @id @default(cuid())
  adId          String
  transactionId String?
  amount        Float
  currency      String   @default("USD")
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  ad CommunityAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([transactionId])
}

// Social: followers/following
model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followerId])
  @@index([followeeId])
}

// Notifications for in-app alerts
model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  title     String?
  body      String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([isRead])
}

// ===== Market Intelligence Models =====
model AiAutomationLog {
  id          String   @id @default(cuid())
  eventType   String
  handledByAI Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([handledByAI])
  @@index([createdAt])
}

model LtvPrediction {
  id               String   @id @default(cuid())
  userId           String
  name             String
  role             String
  predictedLtv     Float
  velocity         String
  churnRiskPercent Float
  recommendation   String
  confidence       String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([confidence])
  @@index([createdAt])
}

model DemandForecast {
  id                String   @id @default(cuid())
  domain            String
  skill             String
  horizon           String
  growthPct         Float
  suggestedRateMin  Float
  suggestedRateMax  Float
  suggestedRateUnit String
  confidencePct     Float
  createdAt         DateTime @default(now())

  @@index([domain])
  @@index([horizon])
  @@index([createdAt])
}

model OpportunityRadarSnapshot {
  id             String   @id @default(cuid())
  signalsScanned Int
  summary        String
  reportRoute    String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model MarketInsightSnapshot {
  id                 String   @id @default(cuid())
  range              String
  gmv                Float
  previousGmv        Float
  takeRatePercent    Float
  netRevenue         Float
  automationPercent  Float?
  automationChange   Float?
  disputePercent     Float
  industryAvgPercent Float
  createdAt          DateTime @default(now())

  @@index([range])
  @@index([createdAt])
}

