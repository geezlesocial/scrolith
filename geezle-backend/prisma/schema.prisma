/// Phase 29.1 — content toggles and content policy flags (1:1 with group Conversation)
model ConversationSettings {
  id                      String   @id @default(cuid())
  conversationId          String   @unique
  allowImages             Boolean  @default(true)
  allowVideos             Boolean  @default(true)
  allowFiles              Boolean  @default(true)
  allowAudio              Boolean  @default(true)
  allowVoice              Boolean  @default(true)
  allowGifs               Boolean  @default(true)
  allowStickers           Boolean  @default(true)
  allowPolls              Boolean  @default(true)
  allowEvents             Boolean  @default(true)
  allowLocation           Boolean  @default(false)
  allowContacts           Boolean  @default(false)
  allowReactions          Boolean  @default(true)
  allowEditing            Boolean  @default(true)
  allowDelete             Boolean  @default(true)
  allowForward            Boolean  @default(true)
  allowCopy               Boolean  @default(true)
  allowExternalLinks      Boolean  @default(true)
  maxMentionsPerMessage   Int      @default(20)
  messageApprovalRequired Boolean  @default(false)
  mediaApprovalRequired   Boolean  @default(false)
  /// Advanced filters / keyword lists / AI hooks (opaque JSON)
  policyJson              Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// Phase 29.1 — join requests (REQUEST join policy)
model ConversationJoinRequest {
