model DirectMessage {
  id               String            @id @default(cuid())
  conversationId   String
  senderId         String
  text             String            @db.Text
  messageType      DirectMessageType @default(TEXT)
  metadata         Json?
  attachments      String[]          @default([])
  replyToMessageId String?
  replyToSnapshot  Json?
