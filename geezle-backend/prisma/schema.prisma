  PRIVATE
}

enum ChannelType {
  PUBLIC
  PRIVATE
  CLUB
  EVENT
}

enum EventType {
  WORKSHOP
  MEETUP
  WEBINAR
}

enum ReactionTargetType {
  POST
  COMMENT
  MESSAGE
}

enum PreloaderStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PreloaderLoaderType {
