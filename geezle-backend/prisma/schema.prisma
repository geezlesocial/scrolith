  actorUser    User?          @relation("MessageRecordActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?          @relation("MessageRecordTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([conversationId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([actorUserId, action, conversationId])
}

