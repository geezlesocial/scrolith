  createdByStaffId String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  beforeSnapshot ConfigSnapshot? @relation("RollbackBeforeSnapshot", fields: [beforeSnapshotId], references: [id], onDelete: SetNull)
  afterSnapshot  ConfigSnapshot? @relation("RollbackAfterSnapshot", fields: [afterSnapshotId], references: [id], onDelete: SetNull)

  @@index([scope, key, createdAt])
  @@index([status, createdAt])
  @@index([createdByStaffId, createdAt])
}

