generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String?   @unique
  passwordHash       String?
  name               String?
  role               Role      @default(USER)
  avatar             String?
  profilePhotoFileId String?
  phone              String?
  country            String?
  timezone           String?
  kycStatus          KYCStatus @default(PENDING)
  isVerified         Boolean   @default(false)
  isActive           Boolean   @default(true)
  isOnline           Boolean   @default(false)
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  freelancerPlanId         String?
  freelancerPlanName       String?
  freelancerPlanInterval   String?
  freelancerPlanPrice      Float?
  freelancerPlanCurrency   String?
  freelancerPlanActive     Boolean   @default(false)
  freelancerPlanPurchasedAt DateTime?
  freelancerPlanExpiresAt   DateTime?
  employerPlanId           String?
  employerPlanName         String?
  employerPlanInterval     String?
  employerPlanPrice        Float?
  employerPlanCurrency     String?
  employerPlanActive       Boolean   @default(false)
  employerPlanPurchasedAt  DateTime?
  employerPlanExpiresAt    DateTime?
  stripeAccountId    String?
  refreshToken       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationships
  profile              Profile?
  settings             UserSettings?
  gigs                 Gig[]
  jobs                 Job[]
  wallet               Wallet?
  transactions         Transaction[]
  walletFundingIntents WalletFundingIntent[]

  // Order relationships
  clientOrders     Order[] @relation("OrderClient")
  freelancerOrders Order[] @relation("OrderFreelancer")

  // Contracts (ATM Tracker)
  clientContracts     Contract[] @relation("ClientContracts")
  freelancerContracts Contract[] @relation("FreelancerContracts")

  // Reviews
  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")

  // Proposals
  proposals Proposal[]

  // Favorites
  favorites Favorite[]
  cart      Cart?

  // Gcoin
  gcoinWallet       GcoinWallet?
  gcoinTransactions GcoinTransaction[]       @relation("GcoinUserTransactions")
  gcoinConversions  GcoinConversionRequest[] @relation("GcoinUserConversions")

  // Withdrawal requests
  withdrawalRequests WithdrawalRequest[]

  // CMS Config updates
  cmsConfigUpdates CMSConfig[]

  // Admin-created Gcoin configs
  gcoinConfigsUpdated GcoinConfig[]
  preloaderConfigsUpdated PreloaderConfig[]
  translationValuesUpdated TranslationValue[] @relation("TranslationValueUpdatedBy")
  textOverridesUpdated     TextOverride[]     @relation("TextOverrideUpdatedBy")
  languageConfigsUpdated   LanguageConfig[]   @relation("LanguageConfigUpdatedBy")

  // Market intelligence relationships
  ltvPredictions LtvPrediction[]

  // Community relationships
  forumThreads       ForumThread[]
  forumComments      ForumComment[]
  forumLikes         ForumLike[]
  communityClubs     CommunityClub[]     @relation("ClubOwner")
  clubMemberships    ClubMembership[]
  communityEvents    CommunityEvent[]    @relation("EventHost")
  eventRegistrations EventRegistration[]
  communityChannels  CommunityChannel[]  @relation("ChannelOwner")
  channelMemberships ChannelMembership[]
  communityMessages  CommunityMessage[]
  kycSubmissions     KYCSubmission[]
  kycDocuments       KYCDocument[]

  // Direct messaging
  conversations       ConversationParticipant[]
  sentMessages        DirectMessage[]
  messageReactions    MessageReaction[]
  messageRecordActions DirectMessageRecord[] @relation("MessageRecordActor")
  messageRecordTargets DirectMessageRecord[] @relation("MessageRecordTarget")
  reactions           Reaction[]

  // Social relations (followers & following)
  following UserFollow[] @relation("UserFollows")
  followers UserFollow[] @relation("UserFollowers")

  // Notifications
  notifications      Notification[] @relation("NotificationUser")
  notificationsActed Notification[] @relation("NotificationActor")
  deviceTokens       DeviceToken[]
  passwordResetTokens PasswordResetToken[]
  authAuditLogs       AuthAuditLog[]

  // Social / OAuth providers
  authProviderAccounts AuthProviderAccount[]

  // Community posts, earnings, and ads relations
  communityPosts     CommunityPost[]
  gcoinEarningEvents GcoinEarningEvent[]
  communityAds       CommunityAd[]
  communityPostComments  CommunityPostComment[]
  communityPostReactions CommunityPostReaction[]
  communityPostCommentLikes CommunityPostCommentLike[]
  communityStories       CommunityStory[]
  communityStoryLikes    CommunityStoryLike[]
  communityStoryViews    CommunityStoryView[]
  communityBusinessPages CommunityBusinessPage[] @relation("BusinessPageOwner")
  businessPageFollows    CommunityBusinessPageFollower[]
  businessPageAdminships CommunityBusinessPageAdmin[]

  // Profile views
  profileViewsReceived ProfileView[] @relation("ProfileViewViewed")
  profileViewsGiven    ProfileView[] @relation("ProfileViewViewer")

  // Community user blocks
  blocksInitiated UserBlock[] @relation("UserBlocksBy")
  blocksReceived  UserBlock[] @relation("UserBlocksFor")

  // Staff/RBAC
  staffProfile StaffUser?

  // Monetization
  monetizationApplications       MonetizationApplication[] @relation("UserMonetizationApplications")
  monetizationReviewedApplications MonetizationApplication[] @relation("MonetizationReviewedBy")
  monetizationProfile            MonetizationProfile?      @relation("UserMonetizationProfile")
  accountViolations              AccountViolation[]         @relation("UserAccountViolations")
  payoutProviderAccounts         PayoutProviderAccount[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  title           String?
  bio             String?
  location        String?
  gender          String?
  dateOfBirth     DateTime?
  showBirthMonthDayPublic Boolean @default(true)
  skills          String[]
  hourlyRate      Float?
  experience      String?
  education       String?
  languages       String[]
  introVideoUrl   String?
  coverPhotoUrl   String?
  portfolio       Json?
  experienceItems Json?
  educationItems  Json?
  certifications  Json?
  portfolioUrl    String?
  githubUrl       String?
  linkedinUrl     String?
  websiteUrl      String?
  rating          Float    @default(0)
  completedJobs   Int      @default(0)
  responseRate    Float    @default(0)
  responseTime    Int? // in hours
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ProfileView {
  id           String   @id @default(cuid())
  viewerId     String?
  viewedUserId String
  createdAt    DateTime @default(now())

  viewer     User? @relation("ProfileViewViewer", fields: [viewerId], references: [id])
  viewedUser User  @relation("ProfileViewViewed", fields: [viewedUserId], references: [id])

  @@index([viewedUserId, createdAt])
  @@index([viewerId, createdAt])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  inAppNotifications Boolean  @default(true)
  messageRequestsNotifications Boolean @default(true)
  allowInMail        Boolean  @default(true)
  notifyMentions     Boolean  @default(true)
  notifyFollowedPosts Boolean @default(true)
  notifyFollowedYou  Boolean  @default(true)
  notifyCommentsOnPosts Boolean @default(true)
  notifyReactionsOnPosts Boolean @default(true)
  notifyReposts      Boolean  @default(true)
  notifyJobApplications Boolean @default(true)
  notifyApplicationUpdates Boolean @default(true)
  marketingEmails    Boolean  @default(true)
  // Earning rules
  viewsUnit            Int      @default(10000)
  likesUnit            Int      @default(100)
  repostsUnit          Int      @default(50)
  sharesUnit           Int      @default(200)
  coinPerViewsUnit     Float    @default(1)
  coinPerLikesUnit     Float    @default(1)
  coinPerRepostsUnit   Float    @default(1)
  coinPerSharesUnit    Float    @default(1)
  // Admin fee on earnings (e.g., 0.1 = 10%)
  adminFeePercent      Float    @default(0.1)
  // Transfer fee settings
  transferFeeType      String   @default("percentage")
  transferFeeValue     Float    @default(0)
  twoFactorEnabled   Boolean  @default(false)
  loginAlerts        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Gig {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String
  price        Float
  deliveryTime Int // in days
  revisions    Int         @default(1)
  categoryId   String?
  subcategory  String?
  pricingMode  String      @default("packages")
  packages     Json?
  extras       Json?
  faqs         Json?
  requirements Json?
  images       String[]    @default([])
  videos       String[]    @default([])
  documents    String[]    @default([])
  tags         String[]    @default([])
  image        String?
  meta         Json?
  userId       String
  rating       Float?      @default(0)
  reviewCount  Int         @default(0)
  isActive     Boolean     @default(true)
  isFeatured   Boolean     @default(false)
  isTopSelected Boolean    @default(false)
  isRecommended Boolean    @default(false)
  status       GigStatus   @default(PENDING)
  adminStatus  AdminStatus @default(PENDING)
  adminReason  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relationships
  category Category? @relation(fields: [categoryId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  orders   Order[]
  reviews  Review[]
  cartItems CartItem[]
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String
  budget          String?
  type            JobType          @default(FIXED_PRICE)
  postedTime      DateTime         @default(now())
  tags            String[]
  proposalsCount  Int              @default(0)
  status          JobStatus        @default(DRAFT)
  isActive        Boolean          @default(true)
  isVisible       Boolean          @default(true)
  categoryId      String?
  subcategory     String?
  experienceLevel ExperienceLevel?
  visibility      Visibility       @default(PUBLIC)
  duration        String?
  attachments     String[]
  isFeatured      Boolean          @default(false)
  isTopSelected   Boolean          @default(false)
  isRecommended   Boolean          @default(false)
  adminStatus     AdminStatus      @default(PENDING)
  adminReason     String?
  clientId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category  Category?  @relation(fields: [categoryId], references: [id])
  client    User       @relation(fields: [clientId], references: [id])
  proposals Proposal[]
  cartItems CartItem[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
}

model Proposal {
  id               String         @id @default(cuid())
  jobId            String
  freelancerId     String
  coverLetter      String         @db.Text
  proposedAmount   Float
  proposedTimeline Int
  attachments      String[]       @default([])
  status           ProposalStatus @default(PENDING)
  rejectionReason  String?
  contractId       String?
  clientViewedAt   DateTime?
  clientViewCount  Int            @default(0)
  topApplicantAt   DateTime?
  interviewScheduledAt DateTime?
  interviewMode    String?
  interviewLocation String?
  interviewNotes   String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer User @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
}

model Contract {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        ContractType @default(HOURLY)

  clientId       String
  freelancerId   String
  clientName     String?
  freelancerName String?

  hourlyRate   Float        @default(0)
  paymentCycle PaymentCycle @default(WEEKLY)

  status    ContractStatus @default(ACTIVE)
  startDate DateTime       @default(now())

  jobId            String?
  sourceProposalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     User @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User @relation("FreelancerContracts", fields: [freelancerId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]
  sessions    TrackingSession[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model TimeEntry {
  id           String @id @default(cuid())
  contractId   String
  freelancerId String

  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int
  description     String
  status          TimeEntryStatus @default(PENDING)
  earnings        Float           @default(0)
  screenshots     String[]        @default([])
  activityScore   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([freelancerId])
  @@index([status])
  @@index([startTime])
  @@index([createdAt])
}

model TrackingSession {
  id           String        @id @default(cuid())
  contractId   String
  freelancerId String
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  status       SessionStatus @default(ACTIVE)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([freelancerId])
  @@index([status])
  @@index([startedAt])
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  icon        String?
  description String?
  type        CategoryType @default(GIG)
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  parent       Category?     @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryChildren")
  gigs         Gig[]
  jobs         Job[]
  forumThreads ForumThread[] @relation("ForumCategory")
}

model Order {
  id             String      @id @default(cuid())
  gigId          String?
  clientId       String
  freelancerId   String
  amount         Float
  status         OrderStatus @default(PENDING)
  requirements   String?
  deliveryDate   DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  stripeIntentId String?
  transactionId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relationships
  gig          Gig?          @relation(fields: [gigId], references: [id])
  client       User          @relation("OrderClient", fields: [clientId], references: [id])
  freelancer   User          @relation("OrderFreelancer", fields: [freelancerId], references: [id])
  escrow       Escrow?
  transactions Transaction[]
  review       Review?
  paymentIntents OrderPaymentIntent[]
}

model Review {
  id          String       @id @default(cuid())
  rating      Int
  title       String?
  comment     String?      @db.Text
  gigId       String?
  orderId     String?      @unique
  authorId    String
  subjectId   String
  status      ReviewStatus @default(PENDING)
  editedAt    DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  gig     Gig?   @relation(fields: [gigId], references: [id], onDelete: SetNull)
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  author  User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@index([authorId])
  @@index([subjectId])
  @@index([status])
}

model KYCSubmission {
  id              String              @id @default(cuid())
  userId          String
  status          KYCSubmissionStatus @default(PENDING)
  personalInfo    Json
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents KYCDocument[]

  @@index([userId])
  @@index([status])
}

model KYCDocument {
  id              String   @id @default(cuid())
  submissionId    String?
  userId          String
  type            String
  fileId          String
  fileUrl         String
  status          String   @default("pending")
  rejectionReason String?
  uploadedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submission KYCSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([userId])
}

// Application-level settings storage for scoped JSON config
model AppSetting {
  id        String   @id @default(cuid())
  scope     String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model TranslationKey {
  id          String   @id @default(cuid())
  key         String   @unique
  namespace   String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values TranslationValue[]

  @@index([namespace])
  @@index([isActive])
}

model TranslationValue {
  id               String   @id @default(cuid())
  translationKeyId String
  locale           String
  value            String   @db.Text
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  translationKey TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)
  updatedByAdmin User?          @relation("TranslationValueUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([translationKeyId, locale])
  @@index([locale])
  @@index([updatedByAdminId])
  @@index([updatedAt])
}

model TextOverride {
  id               String   @id @default(cuid())
  locale           String
  matchText        String   @db.Text
  replacementText  String   @db.Text
  isRegex          Boolean  @default(false)
  enabled          Boolean  @default(true)
  priority         Int      @default(100)
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  updatedByAdmin User? @relation("TextOverrideUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([locale, enabled, priority])
  @@index([updatedByAdminId])
  @@index([updatedAt])
}

model LanguageConfig {
  id                    String   @id @default(cuid())
  scope                 String   @unique @default("default")
  defaultLocale         String   @default("en")
  enabledLocales        String[] @default(["en"])
  rtlLocales            String[] @default([])
  dictionaryCacheSeconds Int     @default(300)
  overridesCacheSeconds  Int     @default(300)
  updatedByAdminId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  updatedByAdmin User? @relation("LanguageConfigUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([updatedByAdminId])
  @@index([updatedAt])
}

model RecoConfig {
  id         String   @id @default(cuid())
  surface    String
  entityType String   @map("entity_type")
  mode       String   @default("hybrid")
  enabled    Boolean  @default(true)
  weights    Json
  gating     Json
  penalties  Json
  diversity  Json
  coldStart  Json     @map("cold_start")
  notes      String?
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([surface, entityType])
  @@index([surface])
  @@index([entityType])
  @@map("reco_config")
}

model RecoManualRule {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @default("*") @map("entity_id")
  action     String
  value      Float?
  priority   Int      @default(100)
  surface    String   @default("*")
  startAt    DateTime? @map("start_at")
  endAt      DateTime? @map("end_at")
  isActive   Boolean  @default(true) @map("is_active")
  metadata   Json?
  note       String?
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([surface, isActive])
  @@index([startAt, endAt])
  @@map("reco_manual_rule")
}

model RecoImpressionLog {
  id         String   @id @default(cuid())
  viewerId   String   @map("viewer_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  surface    String
  shownAtDay DateTime @map("shown_at_day")
  count      Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([viewerId, entityType, entityId, surface, shownAtDay])
  @@index([entityType, entityId, surface, shownAtDay])
  @@index([viewerId, shownAtDay])
  @@map("reco_impression_log")
}

model RecoFeedbackLog {
  id         String   @id @default(cuid())
  viewerId   String?  @map("viewer_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  surface    String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, surface, action, createdAt])
  @@index([viewerId, createdAt])
  @@map("reco_feedback_log")
}

model ScrolithaConversation {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  userRole        String   @map("user_role")
  scope           String   @default("user")
  status          String   @default("open")
  pageContext     String?  @map("page_context")
  entityContextId String?  @map("entity_context_id")
  summary         String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  messages    ScrolithaMessage[]
  actionPlans ScrolithaActionPlan[]
  feedback    ScrolithaFeedback[]
  audits      ScrolithaAuditLog[]

  @@index([userId, createdAt])
  @@index([scope, status, createdAt])
  @@map("scrolitha_conversation")
}

model ScrolithaMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  sender         String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ScrolithaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("scrolitha_message")
}

model ScrolithaSkill {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  roleScope       String[] @default([])
  description     String   @db.Text
  inputsSchema    Json     @map("inputs_schema")
  stepsSchema     Json     @map("steps_schema")
  successCriteria Json     @map("success_criteria")
  isActive        Boolean  @default(true) @map("is_active")
  version         Int      @default(1)
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, updatedAt])
  @@map("scrolitha_skill")
}

model ScrolithaActionPlan {
  id                 String   @id @default(cuid())
  conversationId     String   @map("conversation_id")
  userId             String   @map("user_id")
  userRole           String   @map("user_role")
  scope              String   @default("user")
  actionKey          String   @map("action_key")
  toolKey            String   @map("tool_key")
  summary            String   @db.Text
  requiresConfirmation Boolean @default(false) @map("requires_confirmation")
  confirmationStatus String   @default("not_required") @map("confirmation_status")
  status             String   @default("planned")
  paramsPreview      Json?    @map("params_preview")
  paramsRedacted     Json?    @map("params_redacted")
  resultPayload      Json?    @map("result_payload")
  errorCode          String?  @map("error_code")
  errorMessage       String?  @map("error_message")
  confirmedAt        DateTime? @map("confirmed_at")
  executedAt         DateTime? @map("executed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  conversation ScrolithaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  audits       ScrolithaAuditLog[]

  @@index([conversationId, createdAt])
  @@index([userId, status, createdAt])
  @@index([toolKey, status, createdAt])
  @@map("scrolitha_action_plan")
}

model ScrolithaAuditLog {
  id                  String   @id @default(cuid())
  actorId             String   @map("actor_id")
  actorRole           String   @map("actor_role")
  actorScope          String   @map("actor_scope")
  conversationId      String?  @map("conversation_id")
  actionPlanId        String?  @map("action_plan_id")
  eventType           String   @map("event_type")
  intent              String?
  toolKey             String?  @map("tool_key")
  requestPayload      Json?    @map("request_payload")
  redactedPayload     Json?    @map("redacted_payload")
  resultStatus        String   @default("ok") @map("result_status")
  resultSummary       String?  @map("result_summary")
  confirmationStatus  String?  @map("confirmation_status")
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent")
  createdAt           DateTime @default(now()) @map("created_at")

  conversation ScrolithaConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actionPlan   ScrolithaActionPlan?   @relation(fields: [actionPlanId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
