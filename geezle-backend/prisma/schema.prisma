  metadata         Json?
  createdByStaffId String?
  createdAt        DateTime @default(now())

  beforeSnapshot ConfigSnapshot? @relation("ConfigChangeBeforeSnapshot", fields: [beforeSnapshotId], references: [id], onDelete: SetNull)
  afterSnapshot  ConfigSnapshot? @relation("ConfigChangeAfterSnapshot", fields: [afterSnapshotId], references: [id], onDelete: SetNull)

  @@index([scope, key, createdAt])
  @@index([action, createdAt])
  @@index([createdByStaffId, createdAt])
}

