model GcoinSettings {
  id                   String   @id @default(cuid())
  conversionRate       Float    @default(0)
  minWithdrawal        Int      @default(0)
  conversionEnabled    Boolean  @default(false)
  autoApproveConversions Boolean @default(false)
  userTransfersEnabled Boolean  @default(false)
  // Transfer fee settings (admin-configurable)
  transferFeeType      String   @default("percentage")
  transferFeeValue     Float    @default(0)
  // Earning rate configuration: X events => Y Gcoin
  viewsUnit            Int      @default(10000)
  likesUnit            Int      @default(100)
  repostsUnit          Int      @default(50)
  sharesUnit           Int      @default(200)
  coinPerViewsUnit     Float    @default(1)
  coinPerLikesUnit     Float    @default(1)
  coinPerRepostsUnit   Float    @default(1)
  coinPerSharesUnit    Float    @default(1)
