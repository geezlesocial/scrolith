  @@index([domain])
  @@index([horizon])
  @@index([createdAt])
}

model OpportunityRadarSnapshot {
  id             String   @id @default(cuid())
  signalsScanned Int
  summary        String
  reportRoute    String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model MarketInsightSnapshot {
  id                 String   @id @default(cuid())
  range              String
  gmv                Float
  previousGmv        Float
  takeRatePercent    Float
  netRevenue         Float
  automationPercent  Float?
  automationChange   Float?
  disputePercent     Float
  industryAvgPercent Float
  createdAt          DateTime @default(now())

  @@index([range])
  @@index([createdAt])
}

model CommunityConfig {
  id                String   @id @default(cuid())
  communityEnabled  Boolean  @default(true)
  storiesEnabled    Boolean  @default(true)
  adsEnabled        Boolean  @default(true)
  gcoinEnabled      Boolean  @default(false)
  businessPagesEnabled Boolean @default(true)
  businessPageUserCreationEnabled Boolean @default(true)
  businessPagePostingEnabled Boolean @default(true)
  businessPageFollowEnabled Boolean @default(true)
  maxImagesPerPost  Int      @default(5)
  maxVideoSizeMb    Int      @default(50)
  storyExpiryHours  Int      @default(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("community_config")
}

model PreloaderConfig {
  id                String                     @id @default(cuid())
  name              String
  status            PreloaderStatus            @default(DRAFT)
  isActive          Boolean                    @default(false)
  minDurationMs     Int                        @default(800)
  maxDurationMs     Int                        @default(5000)
  showOnInitialLoad Boolean                    @default(true)
  showOnRouteChange Boolean                    @default(true)
  showOnApiLoading  Boolean                    @default(false)
  headlineText      String?
  subText           String?
  loaderType        PreloaderLoaderType        @default(SPINNER)
  logoFileId        String?
  backgroundType    PreloaderBackgroundType    @default(SOLID)
  backgroundColor   String                     @default("#0f172a")
  gradientFrom      String?
  gradientTo        String?
  overlayOpacity    Float                      @default(0.85)
  blurPx            Int                        @default(0)
  accentColor       String                     @default("#3b82f6")
  textColor         String                     @default("#ffffff")
  animationSpeed    Float                      @default(1)
  position          PreloaderPosition          @default(CENTER)
  customCss         String?
  updatedByAdminId  String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  updatedByAdmin User? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([status])
  @@index([updatedByAdminId])
}

