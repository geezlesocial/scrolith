// Direct messaging (1:1 and group)
model Conversation {
  id                  String            @id @default(cuid())
  type                ConversationType @default(DIRECT)
  lastMessageText     String?
  lastMessageAt       DateTime?
  lastMessageSenderId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
  messageRecords DirectMessageRecord[]

  @@index([updatedAt])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  label          String   @default("other")
  isStarred      Boolean  @default(false)
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String   @db.Text
  attachments    String[] @default([])
  replyToMessageId String?
  replyToSnapshot  Json?
  isSystem       Boolean  @default(false)
  aiFlagged      Boolean  @default(false)
  aiReason       String?
  editedAt       DateTime?
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyToMessage DirectMessage? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        DirectMessage[] @relation("MessageReplies")
  reactions    MessageReaction[]
  records      DirectMessageRecord[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([replyToMessageId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DirectMessageRecord {
  id                String   @id @default(cuid())
  messageId         String?
  conversationId    String
  action            String
  actorUserId       String?
  targetUserId      String?
  beforeText        String?  @db.Text
  afterText         String?  @db.Text
  beforeAttachments String[] @default([])
  afterAttachments  String[] @default([])
  metadata          Json?
  createdAt         DateTime @default(now())

  message      DirectMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser    User?          @relation("MessageRecordActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?          @relation("MessageRecordTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([conversationId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
}

model Reaction {
  id         String             @id @default(cuid())
  userId     String
  targetType ReactionTargetType
  targetId   String
  reactionKey String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([targetType, targetId, reactionKey])
  @@index([userId])
}

model ReactionSummary {
  id         String             @id @default(cuid())
  targetType ReactionTargetType
  targetId   String
  counts     Json
  updatedAt  DateTime           @updatedAt
  createdAt  DateTime           @default(now())

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
}

// Community Post model for feed-style posts (separate from ForumThread)
model CommunityPost {
  id           String   @id @default(cuid())
  authorId     String
  title        String?
  content      String   @db.Text
  attachments  String[] @default([])
  tags         String[] @default([])
  mentions     String[] @default([])
  topic        String?
  location     String?
  visibility   String   @default("public") // public, friends, network, private, custom
  commentPolicy String  @default("everyone") // everyone, followers, following, mutuals, none
  originalPostId String?
  businessPageId String?
  viewsCount   Int      @default(0)
  likesCount   Int      @default(0)
  sharesCount  Int      @default(0)
  repostsCount Int      @default(0)
  status       String   @default("active") // active, draft, deleted
  isPinned     Boolean  @default(false)
  isHighlighted Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  businessPage CommunityBusinessPage? @relation(fields: [businessPageId], references: [id], onDelete: SetNull)
  originalPost CommunityPost? @relation("CommunityPostReposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      CommunityPost[] @relation("CommunityPostReposts")

  // Earning events and relations
  earningEvents GcoinEarningEvent[]
  comments      CommunityPostComment[]
  reactions     CommunityPostReaction[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@index([businessPageId])
  @@index([visibility])
  @@index([topic])
  @@index([location])
}

model CommunityPostComment {
  id          String   @id @default(cuid())
  postId      String
  authorId    String
  parentId    String?
  content     String   @db.Text
  attachments String[] @default([])
  status      String   @default("active") // active, deleted
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post   CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent CommunityPostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPostComment[] @relation("PostCommentReplies")
  likes  CommunityPostCommentLike[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

model CommunityPostCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment CommunityPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model CommunityPostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([type])
}

model CommunityStory {
  id             String   @id @default(cuid())
  authorId       String
  type           String   @default("text") // text, image, video
  content        String?
