  metadata         Json?
  createdByStaffId String?
  createdAt        DateTime @default(now())

  @@index([scope, createdAt])
  @@index([releaseKey, createdAt])
  @@index([createdByStaffId, createdAt])
}

model SocketSession {
  id               String    @id @default(cuid())
  socketId         String    @unique
  namespace        String
  userId           String?
  role             String?
  transport        String?
  authSource       String?
  isAuthenticated  Boolean   @default(false)
  rooms            String[]
  handshakeQuery   Json?
  metadata         Json?
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  disconnectReason String?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([namespace, connectedAt])
  @@index([userId, connectedAt])
  @@index([isAuthenticated, connectedAt])
  @@index([disconnectedAt, connectedAt])
}

model PresenceLease {
  id         String    @id @default(cuid())
  socketId   String    @unique
  userId     String
  namespace  String
  status     String    @default("ACTIVE")
  rooms      String[]
  metadata   Json?
  acquiredAt DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status, lastSeenAt])
  @@index([namespace, status, lastSeenAt])
  @@index([releasedAt])
}

model EventDelivery {
  id                 String    @id @default(cuid())
  namespace          String
  roomKey            String?
  eventName          String
  status             String    @default("SENT")
  targetCount        Int       @default(0)
  triggeredBy        String    @default("system")
  triggeredByStaffId String?
  deliveryKey        String?
  payload            Json?
  metadata           Json?
  occurredAt         DateTime  @default(now())
  replayedAt         DateTime?
  createdAt          DateTime  @default(now())

  replayJobs DeliveryReplayJob[]

  @@index([namespace, occurredAt])
  @@index([eventName, occurredAt])
  @@index([roomKey, occurredAt])
  @@index([status, occurredAt])
  @@index([triggeredByStaffId, occurredAt])
}

model RealtimeIncident {
  id                String    @id @default(cuid())
  code              String
  severity          String    @default("ERROR")
  status            String    @default("OPEN")
  source            String    @default("socket")
  message           String
  notes             String?
  details           Json?
  occurrences       Int       @default(1)
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedByStaffId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, lastSeenAt])
  @@index([source, status, lastSeenAt])
  @@index([severity, status, lastSeenAt])
  @@index([resolvedByStaffId, resolvedAt])
}

model DeliveryReplayJob {
  id               String    @id @default(cuid())
  deliveryId       String
  namespace        String
  roomKey          String?
  eventName        String
  status           String    @default("COMPLETED")
  payload          Json?
  result           Json?
  createdByStaffId String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  delivery EventDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@index([status, createdAt])
  @@index([createdByStaffId, createdAt])
}

model ContentPolicy {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  description      String?
  contentType      String
  severity         String   @default("MEDIUM")
  action           String   @default("REVIEW")
  thresholds       Json?
  metadata         Json?
  isSystemPolicy   Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdByStaffId String?
  updatedByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([contentType, isActive])
  @@index([severity, isActive])
}

model ModerationAppeal {
  id                String    @id @default(cuid())
  caseId            String
  targetUserId      String?
  submittedByUserId String?
  status            String    @default("OPEN")
  reason            String
  resolutionNotes   String?
  resolvedByStaffId String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId, status, createdAt])
  @@index([targetUserId, createdAt])
  @@index([submittedByUserId, createdAt])
}

model TrustProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  score                Int       @default(100)
  riskLevel            String    @default("LOW")
  kycStatusSnapshot    String?
  isVerifiedSnapshot   Boolean   @default(false)
  activeViolationCount Int       @default(0)
  moderationCaseCount  Int       @default(0)
  resolvedCaseCount    Int       @default(0)
  fraudScoreSnapshot   Int       @default(0)
  signalCount          Int       @default(0)
  lastComputedAt       DateTime?
  metadata             Json?
  updatedByStaffId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([riskLevel, score])
  @@index([lastComputedAt])
}

model RiskSignal {
  id                String    @id @default(cuid())
  userId            String
  signalType        String
  severity          String    @default("MEDIUM")
  source            String    @default("manual")
  status            String    @default("ACTIVE")
  reason            String
  metadata          Json?
  expiresAt         DateTime?
  createdByStaffId  String?
  resolvedByStaffId String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status, createdAt])
  @@index([signalType, severity, status])
  @@index([expiresAt])
}

model ModerationAuditLog {
  id         String   @id @default(cuid())
  staffId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

// Password reset tokens (hashed; single-use)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

// Auth/security audit events (password resets, login alerts, etc.)
model AuthAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  event     String
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

// Device tokens for mobile push notifications
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  platform   String
  deviceId   String?
  token      String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@index([deviceId])
}

// ===== Market Intelligence Models =====
model AiAutomationLog {
  id          String   @id @default(cuid())
  eventType   String
  handledByAI Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([handledByAI])
  @@index([createdAt])
}

model LtvPrediction {
  id               String   @id @default(cuid())
  userId           String
  name             String
  role             String
  predictedLtv     Float
  velocity         String
  churnRiskPercent Float
  recommendation   String
  confidence       String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([confidence])
  @@index([createdAt])
}

model DemandForecast {
  id                String   @id @default(cuid())
  domain            String
  skill             String
  horizon           String
  growthPct         Float
  suggestedRateMin  Float
  suggestedRateMax  Float
  suggestedRateUnit String
  confidencePct     Float
  createdAt         DateTime @default(now())

  @@index([domain])
  @@index([horizon])
  @@index([createdAt])
}

model OpportunityRadarSnapshot {
  id             String   @id @default(cuid())
  signalsScanned Int
  summary        String
  reportRoute    String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model MarketInsightSnapshot {
  id                 String   @id @default(cuid())
  range              String
  gmv                Float
  previousGmv        Float
  takeRatePercent    Float
  netRevenue         Float
  automationPercent  Float?
  automationChange   Float?
  disputePercent     Float
  industryAvgPercent Float
  createdAt          DateTime @default(now())

  @@index([range])
  @@index([createdAt])
}

model CommunityConfig {
  id                              String   @id @default(cuid())
  communityEnabled                Boolean  @default(true)
  storiesEnabled                  Boolean  @default(true)
  adsEnabled                      Boolean  @default(true)
  gcoinEnabled                    Boolean  @default(false)
  businessPagesEnabled            Boolean  @default(true)
  businessPageUserCreationEnabled Boolean  @default(true)
  businessPagePostingEnabled      Boolean  @default(true)
  businessPageFollowEnabled       Boolean  @default(true)
  maxImagesPerPost                Int      @default(5)
  maxVideoSizeMb                  Int      @default(50)
  storyExpiryHours                Int      @default(24)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("community_config")
}

model PreloaderConfig {
  id                String                  @id @default(cuid())
  name              String
  status            PreloaderStatus         @default(DRAFT)
  isActive          Boolean                 @default(false)
  minDurationMs     Int                     @default(800)
  maxDurationMs     Int                     @default(5000)
  showOnInitialLoad Boolean                 @default(true)
  showOnRouteChange Boolean                 @default(true)
  showOnApiLoading  Boolean                 @default(false)
  headlineText      String?
  subText           String?
  loaderType        PreloaderLoaderType     @default(SPINNER)
  logoFileId        String?
  backgroundFileId  String?
  backgroundType    PreloaderBackgroundType @default(SOLID)
  backgroundColor   String                  @default("#0f172a")
  gradientFrom      String?
  gradientTo        String?
  overlayOpacity    Float                   @default(0.85)
  blurPx            Int                     @default(0)
  accentColor       String                  @default("#3b82f6")
  textColor         String                  @default("#ffffff")
  animationSpeed    Float                   @default(1)
  position          PreloaderPosition       @default(CENTER)
  customCss         String?
  updatedByAdminId  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  updatedByAdmin User? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([status])
  @@index([updatedByAdminId])
}

