{
  "name": "Scrolith-backend",
  "version": "1.0.0",
  "description": "Scrolith Marketplace Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --config jest.config.cjs --passWithNoTests --runInBand",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d postgres-test",
    "test:db:wait": "node scripts/wait-test-db.mjs",
    "test:db:guard": "node scripts/run-test-db-command.mjs --guard-only",
    "test:db:prepare": "node scripts/run-test-db-command.mjs migrate deploy && node scripts/run-test-db-command.mjs generate",
    "test:db:seed": "node scripts/seed-test-fixtures.mjs",
    "test:db:reset": "node scripts/run-test-db-command.mjs migrate reset --force --skip-seed",
    "test:node": "node scripts/run-node-test-files.mjs",
    "test:full": "node scripts/run-jest-full.mjs",
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.production.json",
    "start": "node dist/server.js",
    "smoke:production": "node scripts/production-smoke.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:create": "npx prisma migrate dev --create-only --name",
    "migrate:add_community": "npx prisma migrate dev --name add_community_gcoin_ads",
    "seed:community": "ts-node prisma/seed/seedCommunity.ts",
    "reconcile:adpayments": "ts-node scripts/reconcileAdPayments.ts",
    "migrate:apply": "npx prisma migrate deploy && npx prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "seed:appsetting": "ts-node scripts/seed_appsetting.ts",
    "seed:admin-settings": "ts-node scripts/seed_admin_and_settings.ts",
    "files:register": "ts-node ./src/scripts/registerExistingFiles.ts",
    "seed:analytics": "ts-node scripts/seed_analytics.ts",
    "create:admin": "ts-node scripts/create_admin.ts",
    "dedupe:config": "ts-node scripts/dedupe_config_rows.ts",
    "repair:legacy-local-files": "ts-node --transpile-only scripts/repairLegacyLocalFiles.ts",
    "media:recovery": "ts-node --transpile-only scripts/mediaHistoricalRecovery.ts",
    "media:recovery:dry-run": "ts-node --transpile-only scripts/mediaHistoricalRecovery.ts --dry-run",
    "media:recovery:repair": "ts-node --transpile-only scripts/mediaHistoricalRecovery.ts --repair --confirm",
    "check-env": "ts-node src/scripts/checkEnv.ts",
    "sync-env": "ts-node src/scripts/syncEnvToSettings.ts",
    "test:docker": "powershell -ExecutionPolicy Bypass -File ./scripts/test-with-docker.ps1",
    "test:phase1": "powershell -ExecutionPolicy Bypass -File ./scripts/phase1-foundation-smoke.ps1",
    "test:phase2": "powershell -ExecutionPolicy Bypass -File ./scripts/phase2-platform-smoke.ps1",
    "test:phase3": "powershell -ExecutionPolicy Bypass -File ./scripts/phase3-platform-smoke.ps1",
    "test:phase4": "powershell -ExecutionPolicy Bypass -File ./scripts/phase4-ecosystem-smoke.ps1"
  },
  "dependencies": {
    "@azure/identity": "4.12.0",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/storage": "^7.14.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.1",
    "@simplewebauthn/server": "^14.0.1",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.6.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "hot-shots": "^13.1.0",
    "ioredis": "^5.9.2",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^17.4.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.3",
    "@types/pdfkit": "^0.17.3",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^2.0.12",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "prisma": "^6.2.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
