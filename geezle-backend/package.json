{
  "name": "geezle-backend",
  "version": "1.0.0",
  "description": "Geezle Marketplace Backend API",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --config jest.config.cjs --passWithNoTests --runInBand",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:create": "npx prisma migrate dev --create-only --name",
    "migrate:add_community": "npx prisma migrate dev --name add_community_gcoin_ads",
    "seed:community": "ts-node prisma/seed/seedCommunity.ts",
    "reconcile:adpayments": "ts-node scripts/reconcileAdPayments.ts",
    "migrate:apply": "npx prisma migrate deploy && npx prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "seed:appsetting": "ts-node scripts/seed_appsetting.ts",
    "files:register": "ts-node ./src/scripts/registerExistingFiles.ts",
    "seed:analytics": "ts-node scripts/seed_analytics.ts",
    "create:admin": "ts-node scripts/create_admin.ts",
    "check-env": "ts-node src/scripts/checkEnv.ts",
    "sync-env": "ts-node src/scripts/syncEnvToSettings.ts"
    ,
    "test:docker": "powershell -ExecutionPolicy Bypass -File ./scripts/test-with-docker.ps1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.12",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^17.4.0",
    "uuid": "^13.0.0"
    ,
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.3",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^2.0.12",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "prisma": "^6.2.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
