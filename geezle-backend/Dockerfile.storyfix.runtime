FROM node:22.18-alpine AS runtime

WORKDIR /app/geezle-backend

COPY package*.json ./
RUN npm ci --include=dev \
  && npm cache clean --force

COPY . .

RUN DATABASE_URL=postgresql://prisma-build:prisma-build@127.0.0.1:5432/prisma_build \
  SHADOW_DATABASE_URL=postgresql://prisma-build:prisma-build@127.0.0.1:5432/prisma_build_shadow \
  npm run prisma:generate
RUN mkdir -p uploads && cp -f assets/brand/runtime-uploads/* uploads/
RUN npm run build:prod

ENV NODE_ENV=production

EXPOSE 8080

# Production migrations are run by the release pipeline before traffic moves.
# Cloud Run instances must not block startup by re-running Prisma work on every scale-out.
CMD ["node", "dist/server.js"]
