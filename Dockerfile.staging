# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
ENV NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ENV CYPRESS_INSTALL_BINARY=0
RUN npm ci --include=dev --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

COPY . .

RUN --mount=type=secret,id=staging_api_origin \
    set -eu; \
    export STAGING_API_ORIGIN="$(cat /run/secrets/staging_api_origin)"; \
    node scripts/stagingFrontendConfig.mjs /tmp/default.conf; \
    export VITE_BACKEND_URL="$STAGING_API_ORIGIN"; \
    export VITE_API_URL="$STAGING_API_ORIGIN/api"; \
    npm run build

FROM nginx:1.27-alpine AS runtime

ARG SOURCE_REPOSITORY
ARG SOURCE_REVISION
ARG DOCKERFILE_SHA256
ARG STAGING_NGINX_TEMPLATE_SHA256

LABEL org.opencontainers.image.source="$SOURCE_REPOSITORY" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.dockerfile="Dockerfile.staging" \
      com.scrolith.dockerfile.sha256="$DOCKERFILE_SHA256" \
      com.scrolith.staging-nginx-template.sha256="$STAGING_NGINX_TEMPLATE_SHA256"

COPY --from=build /tmp/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
