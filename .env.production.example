# =========================
# Scrolith production template
# Copy to .env.production and replace placeholders
# =========================

# -------- Application --------
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# -------- Public URLs --------
FRONTEND_URL=https://app.example.com
PUBLIC_APP_URL=https://app.example.com
BACKEND_URL=https://api.example.com
API_BASE_URL=https://api.example.com
FILE_BASE_URL=https://api.example.com

# -------- Frontend build args --------
VITE_API_URL=https://api.example.com/api
VITE_BACKEND_URL=https://api.example.com
VITE_PUBLIC_APP_DOMAIN=app.example.com

# -------- Database --------
# Local docker compose database example:
POSTGRES_USER=scrolith
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=scrolith_prod
DATABASE_URL=postgresql://scrolith:replace-with-a-strong-password@db:5432/scrolith_prod?schema=public

# -------- Optional services --------
OPENAI_API_KEY=
GOOGLE_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Scrolith
EMAIL_FROM_EMAIL=noreply@example.com

# -------- Storage --------
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -------- Payments --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
